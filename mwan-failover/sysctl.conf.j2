# Forwarding is enabled because this container can announce backup default routes.
{% if mwan_failover_uplink_mode == 'ifupdown' %}
# eth0 still needs router advertisements for its upstream SLAAC address and
# default route after boot, and Linux requires accept_ra=2 in that case.
{% endif %}
net.ipv6.conf.all.forwarding=1
{% if mwan_failover_uplink_mode == 'networkd' %}
# systemd-networkd processes router advertisements instead of the kernel.
net.ipv6.conf.eth0.accept_ra=0
{% else %}
net.ipv6.conf.eth0.accept_ra=2
{% endif %}
net.ipv4.ip_forward=1
