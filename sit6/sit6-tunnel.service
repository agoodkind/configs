[Unit]
Description=6in4 tunnel to Berylax
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# No ExecStop: a restart re-runs the idempotent bring-up, which changes the
# remote in place instead of deleting the tunnel and withdrawing the prefix.
EnvironmentFile=/etc/sit6/sit6.env
ExecStart=/usr/local/sbin/sit6-tunnel-up
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
