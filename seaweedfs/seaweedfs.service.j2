# Managed by Ansible (deploy-seaweedfs.yml).
# All-in-one SeaweedFS server (master + volume + S3) under systemd.
# Binds on all addresses ([::]); the S3 endpoint is reachable only on the
# internal suburban segment via the LXC's own IPv6.
[Unit]
Description=SeaweedFS object store (master, volume, S3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# -volume.max=0 sizes the volume count from free disk. The default is 8, and
# with 1 GB volumes that capped every bucket on this store at one volume once
# the default collection had taken the other seven: production's tack-backups
# volume filled on 2026-07-29 and every write since answered 500 "failed to
# find writable volumes", which silently ended the FoundationDB backup stream
# with 91 GB free on the disk.
ExecStart={{ seaweedfs_bin_path }} server -dir={{ seaweedfs_data_dir }} -s3 -s3.config={{ seaweedfs_config_dir }}/s3.json -ip.bind=:: -master.volumeSizeLimitMB=1024 -volume.max=0
WorkingDirectory={{ seaweedfs_data_dir }}
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
