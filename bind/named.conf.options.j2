options {
    directory "/var/cache/bind";

    // Enable recursion
    recursion yes;
    allow-query { any; };

    // Forward queries to upstream
    forwarders {
        {{ dns64_upstream_dns }};
    };
    forward only;

    // DNSSEC validation
    dnssec-validation auto;

    // Network listeners - IPv6 only as requested
    listen-on-v6 { any; };
    listen-on { none; };

    // DNS64 Configuration
    dns64 {{ dns64_prefix }} {
        clients { any; };
        break-dnssec yes;
{% if dns64_force_synth | bool %}
        // Force synthesis even when the upstream returns a native AAAA, sending
        // every name through the NAT64 translator. Off in every environment: on
        // a segment whose native IPv6 egress works, this only hides that path,
        // and on a segment where it is broken it hides the breakage.
        exclude { any; };
{% endif %}
    };
};
