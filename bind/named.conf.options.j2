options {
    directory "/var/cache/bind";

    // Enable recursion
    recursion yes;
    allow-query { any; };

    // Forward queries to upstream
    forwarders {
        {{ dns64_upstream_dns }};
    };
    forward only;

    // DNSSEC validation
    dnssec-validation auto;

    // Network listeners - IPv6 only as requested
    listen-on-v6 { any; };
    listen-on { none; };

    // DNS64 Configuration
    dns64 {{ dns64_prefix }} {
        clients { any; };
        break-dnssec yes;
{% if dns64_force_synth | bool %}
        // Preserve internal IPv6 records and synthesize external destinations.
        exclude {
{% for prefix in dns64_native_ipv6_prefixes %}
            !{{ prefix }};
{% endfor %}
            any;
        };
{% endif %}
    };
};
