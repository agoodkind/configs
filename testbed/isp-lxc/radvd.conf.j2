interface eth0
{
    AdvSendAdvert on;
    MinRtrAdvInterval {{ isp.ra_min_interval_seconds }};
    MaxRtrAdvInterval {{ isp.ra_max_interval_seconds }};
    AdvManagedFlag on;
    AdvOtherConfigFlag on;
{% if isp.slaac_prefix %}
    # SLAAC /64 (AdvAutonomous on) so the WAN VM autoconfigures a global address,
    # mirroring prod where the ISP RA yields a SLAAC mngtmpaddr. The PD prefix is
    # delegated by kea-dhcp6, not advertised for autoconf here.
    prefix {{ isp.slaac_prefix }}
    {
        AdvOnLink on;
        AdvAutonomous on;
        AdvRouterAddr off;
{% if isp.ra_prefix_valid_lifetime_seconds != 'omit' %}
        AdvValidLifetime {{ isp.ra_prefix_valid_lifetime_seconds }};
{% endif %}
{% if isp.ra_prefix_preferred_lifetime_seconds != 'omit' %}
        AdvPreferredLifetime {{ isp.ra_prefix_preferred_lifetime_seconds }};
{% endif %}
    };
{% endif %}
};
