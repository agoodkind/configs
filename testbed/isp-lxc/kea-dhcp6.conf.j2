{
    "Dhcp6": {
        "interfaces-config": { "interfaces": ["eth0"] },
        "lease-database": { "type": "memfile", "persist": false },
        "preferred-lifetime": {{ isp.dhcp6_preferred_lifetime_seconds }},
        "valid-lifetime": {{ isp.dhcp6_valid_lifetime_seconds }},
{% if isp.dhcp6_renew_seconds != 'omit' %}
        "renew-timer": {{ isp.dhcp6_renew_seconds }},
{% endif %}
{% if isp.dhcp6_rebind_seconds != 'omit' %}
        "rebind-timer": {{ isp.dhcp6_rebind_seconds }},
{% endif %}
{% if isp.dhcp6_dns_servers %}
        "option-data": [{
            "name": "dns-servers",
            "data": {{ isp.dhcp6_dns_servers | join(', ') | to_json }}
        }],
{% endif %}
        "subnet6": [{
            "id": 1,
{% if isp.ia_na %}
            "subnet": "{{ isp.slaac_prefix }}",
            "interface": "eth0",
            "pools": [{ "pool": "{{ isp.ia_na_pool }}" }],
            "pd-pools": [{ "prefix": "{{ isp.pd_prefix | regex_replace('/[0-9]+$', '') }}", "prefix-len": {{ isp.pd_len }}, "delegated-len": {{ isp.pd_len }} }]
{% else %}
            "subnet": "fe80::/10",
            "interface": "eth0",
            "pd-pools": [{ "prefix": "{{ isp.pd_prefix | regex_replace('/[0-9]+$', '') }}", "prefix-len": {{ isp.pd_len }}, "delegated-len": {{ isp.pd_len }} }]
{% endif %}
        }]
    }
}
