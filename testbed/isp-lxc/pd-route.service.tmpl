[Unit]
Description=Route delegated /60 prefix back to the MWAN VM
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/sbin/ip -6 route replace __PD_PREFIX__ via __MWAN_VM_LL__ dev eth0
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
