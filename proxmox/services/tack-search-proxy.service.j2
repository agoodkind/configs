[Unit]
Description=Tack OpenSearch TLS proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/traefik --entryPoints.search.address=[{{ tack_search_proxy_bind_ipv6 }}]:{{ tack_search_proxy_port }} --providers.file.filename=/etc/tack-search-proxy/traefik.yml --log.level=INFO
Restart=on-failure
RestartSec=5s
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/traefik

[Install]
WantedBy=multi-user.target
