[Unit]
Description={{ mwan_watchdog_unit_description }}
After=network.target
Wants=network.target

[Service]
Type=simple
# The watchdog reads its settings from /etc/mwan/config.toml and reads
# SMTP2GO_API_KEY from the optional /etc/mwan/secrets.env file. The leading
# dash lets systemd start the unit when that file does not exist.
EnvironmentFile=-/etc/mwan/secrets.env
ExecStart=/usr/local/bin/mwan watchdog
Restart=always
RestartSec=10
User=root
Group=root
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
