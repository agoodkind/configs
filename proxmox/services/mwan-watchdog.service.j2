[Unit]
Description={{ mwan_watchdog_unit_description }}
After=network.target
Wants=network.target

[Service]
Type=simple
# The leading dash permits startup before the separate secret file exists.
EnvironmentFile=-/etc/mwan/secrets.env
ExecStart=/usr/local/bin/mwan watchdog
Restart=always
RestartSec=10
User=root
Group=root
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
