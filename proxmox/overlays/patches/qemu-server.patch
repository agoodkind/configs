From 0fd4687a520db523e0c2df8180e3fc1743ae505c Mon Sep 17 00:00:00 2001
From: Alexander Goodkind <alex@goodkind.io>
Date: Sat, 3 Oct 2026 21:57:17 -0700
Subject: [PATCH] Add vsock VM option with VM.Config.Vsock authorization and
 vhost-vsock-pci device

Co-authored-by: Claude <noreply@anthropic.com>
---
 src/PVE/API2/Qemu.pm      |  8 ++++++++
 src/PVE/QemuServer.pm     | 11 +++++++++++
 src/PVE/QemuServer/PCI.pm |  1 +
 3 files changed, 20 insertions(+)

diff --git a/src/PVE/API2/Qemu.pm b/src/PVE/API2/Qemu.pm
index 922c6599..ffb51927 100644
--- a/src/PVE/API2/Qemu.pm
+++ b/src/PVE/API2/Qemu.pm
@@ -1011,6 +1011,8 @@ my $check_vm_modify_config_perm = sub {
             $rpcenv->check_vm_perm($authuser, $vmid, $pool, ['VM.Config.Memory']);
         } elsif ($hwtypeoptions->{$opt}) {
             $rpcenv->check_vm_perm($authuser, $vmid, $pool, ['VM.Config.HWType']);
+        } elsif ($opt eq 'vsock') {
+            $rpcenv->check_vm_perm($authuser, $vmid, $pool, ['VM.Config.Vsock']);
         } elsif ($generaloptions->{$opt}) {
             $rpcenv->check_vm_perm($authuser, $vmid, $pool, ['VM.Config.Options']);
             # special case for startup since it changes host behaviour
@@ -2199,6 +2201,11 @@ my $update_vm_api = sub {
 
     &$check_vm_modify_config_perm($rpcenv, $authuser, $vmid, undef, [keys %$param]);
 
+    # revert copies the current value into $param after this point, so check it here
+    &$check_vm_modify_config_perm(
+        $rpcenv, $authuser, $vmid, undef, [grep { $_ eq 'vsock' } keys %$revert],
+    );
+
     &$check_storage_access(
         $rpcenv, $authuser, $storecfg, $vmid, $param, undef, $extraction_storage,
     );
@@ -2649,6 +2656,7 @@ my $vm_config_perm_list = [
     'VM.Config.Memory',
     'VM.Config.Network',
     'VM.Config.HWType',
+    'VM.Config.Vsock',
     'VM.Config.Options',
     'VM.Config.Cloudinit',
 ];
diff --git a/src/PVE/QemuServer.pm b/src/PVE/QemuServer.pm
index f199371d..00edea8c 100644
--- a/src/PVE/QemuServer.pm
+++ b/src/PVE/QemuServer.pm
@@ -544,6 +544,12 @@ args: -no-reboot -smbios 'type=0,vendor=FOO'
 NOTE: this option is for experts only.
 EODESCR
     },
+    vsock => {
+        optional => 1,
+        type => 'boolean',
+        description => "Enable a virtio vsock device with the VM ID as its guest CID.",
+        default => 0,
+    },
     tablet => {
         optional => 1,
         type => 'boolean',
@@ -3297,6 +3303,11 @@ sub config_to_command {
         push @$devices, '-device', 'vmgenid,guid=' . $conf->{vmgenid};
     }
 
+    if ($conf->{vsock}) {
+        push @$devices, '-device',
+            "vhost-vsock-pci,id=vsock0,guest-cid=$vmid" . print_pci_addr('vsock', $arch);
+    }
+
     # add usb controllers
     my @usbcontrollers = PVE::QemuServer::USB::get_usb_controllers($conf, $arch, $machine_version);
     push @$devices, @usbcontrollers if @usbcontrollers;
diff --git a/src/PVE/QemuServer/PCI.pm b/src/PVE/QemuServer/PCI.pm
index d7dc6121..084ac259 100644
--- a/src/PVE/QemuServer/PCI.pm
+++ b/src/PVE/QemuServer/PCI.pm
@@ -220,6 +220,7 @@ sub get_pci_addr_map {
         'pci.4' => { bus => 1, addr => 28 },
         'rng0' => { bus => 1, addr => 29 },
         'pci.2-igd' => { bus => 1, addr => 30 }, # replaces pci.2 in case a legacy IGD device is passed through
+        'vsock' => { bus => 1, addr => 31 },
         'virtio6' => { bus => 2, addr => 1 },
         'virtio7' => { bus => 2, addr => 2 },
         'virtio8' => { bus => 2, addr => 3 },

