{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/CVS": true,
        "**/.retool_types/**": true,
        "**/*tsconfig.json": true,
        ".cache": true,
        "retool.config.json": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.sh.j2": "jinja-shell"
    },
    "ansible.lightspeed.enabled": false,
    "ansible.ansible.configFile": "${workspaceFolder}/ansible/ansible.cfg",
    "ansible.ansible.useFullyQualifiedCollectionNames": true,
    "ansible.ansible.requirementsFile": "${workspaceFolder}/ansible/playbooks/requirements.yml"
}
