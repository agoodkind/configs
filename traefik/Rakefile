#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/rake_common'

desc 'Validate Traefik configuration files'
task :validate do
  require 'yaml'

  puts 'Validating Traefik configuration...'

  # Validate main config
  validate_yaml('traefik.yml')

  # Validate dynamic configs
  Dir.glob('dynamic/*.yml').each do |file|
    validate_yaml(file)
  end

  puts '✅ All Traefik configuration files are valid'
end

# Traefik is configured by the proxy play. The deploy runs through configsctl
# from the repository root, which gates the play's files through the linter,
# redacts vault values, and writes a run log.
desc 'Deploy Traefik configuration'
task :deploy do
  Dir.chdir(File.expand_path('..', __dir__)) do
    sh './configsctl', 'deploy', 'deploy-proxy'
  end
end

task default: :validate

def validate_yaml(file)
  print "  Checking #{file}... "
  YAML.load_file(file)
  puts '✓'
rescue Psych::SyntaxError => e
  puts '✗'
  puts "  Error: #{e.message}"
  exit 1
end
