---
# The maintenance identity also receives the required runtime operations.
_meta:
  type: rolesmapping
  config_version: 2
tack_runtime:
  reserved: true
  users:
    - {{ tack_search_runtime_username }}
    - {{ tack_search_maintenance_username }}
{% if tack_search_keep_legacy_user | bool %}
    - {{ tack_search_username }}
{% endif %}
tack_maintenance:
  reserved: true
  users:
    - {{ tack_search_maintenance_username }}
{% if tack_search_keep_legacy_user | bool %}
    - {{ tack_search_username }}
{% endif %}
tack_health:
  reserved: true
  users:
    - {{ tack_search_health_username }}
