---
# Ansible renders this file from tack/opensearch-internal-users.yml.j2. A
# member reads it into the security index on its first start. The user has
# no backend role because the role mapping file maps it to the tack_search
# role by user name.
_meta:
  type: internalusers
  config_version: 2
{{ tack_search_username }}:
  hash: "{{ tack_search_password_hash }}"
  reserved: true
  description: The Tack application and the Tack operator commands use this user.
