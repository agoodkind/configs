# Tack deployment settings use protected credential files.

# Container image tag. Production uses latest; QA pins a branch build by passing
# tack_image_tag at deploy. Declared in group_vars (tack_all).
TACK_IMAGE_TAG={{ tack_image_tag }}

# Auth mode. development accepts a raw user UUID as the bearer with no token
# lookup; production requires an API token. The compose file requires this
# variable so no environment starts with an undeclared auth mode; each
# environment group declares its value (TACK-261).
ENV={{ tack_env }}

YUGABYTE_DB={{ tack_yugabyte_db }}
TACK_SECRETS_DIR={{ tack_secrets_dir }}
{% if not tack_ops_migrator_login | bool or tack_ledger_bootstrap | bool or tack_cluster_role == 'data' %}
YUGABYTE_USER={{ tack_yugabyte_user }}
YUGABYTE_PASSWORD_FILE=/run/secrets/YUGABYTE_PASSWORD
{% endif %}
AUDIT_WRITER_PASSWORD_FILE=/run/secrets/AUDIT_WRITER_PASSWORD
AUDIT_READER_PASSWORD_FILE=/run/secrets/AUDIT_READER_PASSWORD
AUDIT_REDACTOR_PASSWORD_FILE=/run/secrets/AUDIT_REDACTOR_PASSWORD
AUDIT_OPERATOR_PASSWORD_FILE=/run/secrets/AUDIT_OPERATOR_PASSWORD
TACK_APP_PASSWORD_FILE=/run/secrets/TACK_APP_PASSWORD
TACK_MIGRATOR_PASSWORD_FILE=/run/secrets/TACK_MIGRATOR_PASSWORD
AUDIT_WRITER_DSN_FILE=/run/secrets/AUDIT_WRITER_DSN
AUDIT_READER_DSN_FILE=/run/secrets/AUDIT_READER_DSN
AUDIT_REDACTOR_DSN_FILE=/run/secrets/AUDIT_REDACTOR_DSN
AUDIT_OPERATOR_DSN_FILE=/run/secrets/AUDIT_OPERATOR_DSN
TACK_OPS_AUDIT_OPERATOR_DSN_FILE=/run/secrets/TACK_OPS_AUDIT_OPERATOR_DSN
TACK_OPS_AUDIT_READER_DSN_FILE=/run/secrets/TACK_OPS_AUDIT_READER_DSN
TACK_OPS_AUDIT_REDACTOR_DSN_FILE=/run/secrets/TACK_OPS_AUDIT_REDACTOR_DSN

# Ledger certificate authority and node certificate directory (TACK-460).
# The engine reads its own node certificate from this directory; every
# client verifies the node against the authority file in it. Rendered on
# every host so the compose file and the ops sidecar agree on one path,
# whether or not this environment has turned encryption on.
TACK_LEDGER_CERTS_DIR={{ tack_ledger_certs_dir }}
TACK_LEDGER_TLS_ENABLED={{ tack_ledger_tls_enabled | bool | string | lower }}
{# The node names paired with their guests' addresses, the same map every
   ledger container carries in its hosts file. The SQL dumpers in the ops
   sidecar dial an encrypted node by this name, because their client library
   verifies a certificate by name only and refused the address on the QA
   proof. Rendered only where the consumers dial the data nodes; the legacy
   shape dials the local service by name already. #}
{% if tack_ledger_consumers_repointed %}
TACK_LEDGER_NODE_HOSTS={% for node_name, node_address in tack_ledger_node_addresses.items() %}{{ node_name }}={{ node_address }}{{ ',' if not loop.last else '' }}{% endfor %}

{% else %}
TACK_LEDGER_NODE_HOSTS=
{% endif %}

# Path to the Ed25519 audit signing key on the host.
# Generated once per host with:
#   openssl genpkey -algorithm ed25519 -out /etc/tack/audit-signing.pem
# QA and production MUST use separate keys; sharing keys collapses the
# audit ledger's compliance claim.
AUDIT_SIGNING_KEY_PATH={{ tack_audit_signing_key_path }}

# Valid audit signer set (TACK-437): the signing-key identifiers this
# environment accepts, one per guest that signs. A notarization or an export
# manifest signed under any other identifier fails verification and is
# reported, so a leaked key is contained by removing its identifier here.
# The identifier is what `audit signers` prints as local_signer on the guest.
AUDIT_VALID_SIGNERS={{ tack_audit_valid_signers | join(',') }}
# The guest whose key signs each notarization, stamped on the row so a forged
# row has to claim an origin.
AUDIT_CONSUMER_SIGNING_HOST={{ inventory_hostname }}

# The audit profile starts Kafka and the audit consumer. The consumer writes
# the canonical ledger in YugabyteDB.
#
# The backup profile is added on backup-enabled hosts so deploy keeps the
# long-lived fdb-backup-agent running; the FoundationDB continuous backup needs
# a persistent backup_agent to reach a restorable snapshot.
COMPOSE_PROFILES={{ 'audit,backup' if tack_backup_enabled | bool else 'audit' }}
AUDIT_KAFKA_BROKERS={{ tack_audit_kafka_brokers }}
KAFKA_CLUSTER_ID={{ tack_kafka_cluster_id }}
AUDIT_CONSUMER_YUGABYTE_DSN_FILE=/run/secrets/AUDIT_CONSUMER_YUGABYTE_DSN

# FoundationDB half of the operator audit relay (TACK-328). Opt-in by design:
# a set-but-unreadable cluster file makes the audit-consumer refuse to start,
# which would also halt the YugabyteDB relay and every operator event with it.
# Both deployed hosts mount the cluster file, so both set it.
AUDIT_CONSUMER_FDB_CLUSTER_FILE=/etc/foundationdb/fdb.cluster

# QA data-generator write marker (TACK-338). `ops qa datagen` refuses to write
# unless this is exactly qa or local, so QA sets it and production renders it
# empty. The generator runs through the app service, which reaches FoundationDB
# and holds the audit DSNs.
TACK_DATAGEN_ALLOW_TARGET={{ tack_datagen_allow_target }}

# tack-ops sidecar database URL.
# The ops container runs on host networking and connects to the Yugabyte
# YSQL port on the loopback address of the host (port 5433 is published).
TACK_OPS_DATABASE_URL_FILE=/run/secrets/TACK_OPS_DATABASE_URL
{# An environment with tack_search_enabled false renders no OPENSEARCH_*
   setting because Tack schedules search work, starts search workers, and
   checks the search metadata epoch whenever OPENSEARCH_ENDPOINT is
   non-empty. #}
{% if tack_search_enabled | bool %}

# The OpenSearch client dials one HTTPS endpoint per environment. That
# endpoint is the search proxy on the hypervisor that runs the search guests.
# A new member changes the proxy backends and leaves this endpoint the same.
# The client verifies the endpoint against the search authority at
# OPENSEARCH_CA. The provision and verify commands apply the index topology
# below. OPENSEARCH_PUBLIC_ENABLED turns public search results on or off.
OPENSEARCH_ENDPOINT={{ tack_search_endpoint }}
OPENSEARCH_CA={{ tack_search_ca_path }}
OPENSEARCH_USERNAME={{ tack_search_runtime_username }}
OPENSEARCH_PASSWORD_FILE=/run/secrets/OPENSEARCH_PASSWORD
OPENSEARCH_MAINTENANCE_USERNAME={{ tack_search_maintenance_username }}
OPENSEARCH_MAINTENANCE_PASSWORD_FILE=/run/secrets/OPENSEARCH_MAINTENANCE_PASSWORD
OPENSEARCH_SHARDS={{ tack_search_shards }}
OPENSEARCH_ROUTING_SHARDS={{ tack_search_routing_shards }}
OPENSEARCH_REPLICAS={{ tack_search_replicas }}
OPENSEARCH_PUBLIC_ENABLED={{ tack_search_public_enabled | bool | string | lower }}
OPENSEARCH_MODEL_REPAIR_ENABLED={{ tack_search_model_repair_enabled | bool | string | lower }}
{% if tack_search_public_enabled | bool %}
# Tack signs continuation cursors with this key and reads it only while
# public search is on.
OPENSEARCH_CURSOR_KEY_FILE=/run/secrets/OPENSEARCH_CURSOR_KEY
{% endif %}
{% endif %}
{% if tack_cluster_role == 'search' %}

# The opensearch service in the Tack compose file reads this guest's member
# name and discovery settings from these variables. An empty value leaves
# that setting unset. The template renders the initial cluster manager only
# on the first production member while tack_search_bootstrap_cluster is true.
TACK_SEARCH_NODE_NAME={{ tack_search_node_name }}
TACK_SEARCH_DISCOVERY_TYPE={{ tack_search_discovery_type }}
TACK_SEARCH_SEED_HOSTS={{ tack_search_seed_hosts }}
TACK_SEARCH_INITIAL_CLUSTER_MANAGER_NODES={{ tack_search_initial_cluster_manager_nodes }}
{% endif %}

# Logging
LOG_LEVEL={{ tack_log_level }}
LOG_MAX_BACKUPS={{ tack_log_max_backups }}
LOG_MAX_AGE_DAYS={{ tack_log_max_age_days }}
LOG_MAX_SIZE_MB={{ tack_log_max_size_mb }}

# FDB version (must match the Go bindings pin in go.mod and Makefile).
FDB_VERSION={{ tack_fdb_version }}

# Product store identity for this guest (TACK-408). A guest that runs a store
# process announces its own pinned address from the service inventory and names
# itself as the fault domain, so the cluster counts guests rather than
# containers and a container recreate changes nothing the cluster stored. A
# guest that runs none renders these empty, which keeps the local development
# behavior of announcing the container's own address and hostname.
{% if tack_store_node_present | bool %}
FDB_PUBLIC_ADDRESS={{ service_mapping[service_name].ipv6 }}
FDB_ZONE_ID={{ inventory_hostname }}
FDB_MACHINE_ID={{ inventory_hostname }}
{% else %}
FDB_PUBLIC_ADDRESS=
FDB_ZONE_ID=
FDB_MACHINE_ID=
{% endif %}
# The cluster file a store process writes on its first start on this guest.
{% if tack_store_live_cluster_file %}
FDB_CLUSTER_FILE_CONTENTS={{ tack_store_live_cluster_file }}
{% else %}
FDB_CLUSTER_FILE_CONTENTS=
{% endif %}
# The bound every product-store transaction runs under, retries included.
FDB_TRANSACTION_TIMEOUT={{ tack_store_transaction_timeout }}
# The redundancy `ops provision` configures on a store that has never been
# configured. It changes nothing on a configured cluster.
TACK_OPS_FDB_REDUNDANCY_MODE={{ tack_store_redundancy_mode }}

# HTTP port the app listens on inside the container.
PORT={{ tack_port }}

# Docker IPv6 bridge subnet and gateway, per host. docker-compose.yml reads
# these for networks.default. The NDP proxy prefix (tack_ndp_proxy_prefix) must
# match the subnet.
TACK_DOCKER_V6_SUBNET={{ tack_docker_v6_subnet }}
TACK_DOCKER_V6_GATEWAY={{ tack_docker_v6_gateway }}

# Backup object store (S3-compatible). Rendered only when tack_backup_enabled is
# true (a host with an object store); other hosts omit the whole block instead of
# writing empty values. Only the ops backup commands read these, never the
# request path.
{% if tack_backup_enabled | bool %}
TACK_BACKUP_S3_ENDPOINT={{ tack_backup_s3_endpoint }}
# Bare object-store host, no scheme or port, for the fdb-backup-agent's
# fdb-blobstore-host mapping, because fdbbackup cannot resolve an IPv6 literal.
TACK_BACKUP_S3_HOST={{ tack_backup_s3_host }}
TACK_BACKUP_S3_ACCESS_KEY_ID_FILE=/run/secrets/TACK_BACKUP_S3_ACCESS_KEY_ID
TACK_BACKUP_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/TACK_BACKUP_S3_SECRET_ACCESS_KEY
TACK_BACKUP_S3_REGION={{ tack_backup_s3_region }}
TACK_BACKUP_S3_BUCKET_MAIN={{ tack_backup_s3_bucket_main }}
# Master quorum for the backup one-shot containers; derived in group_vars
# from the ledger topology (local service name while the legacy node
# exists, the data guests' pinned addresses after retirement).
TACK_BACKUP_YB_MASTER_ADDRESSES={{ tack_backup_yb_master_addresses }}
# Snapshot-export paths: the rocksdb root inside the ledger container
# holding the per-tablet snapshot directories, and the host path of the
# patched yugabyted the restore drill bind-mounts.
TACK_BACKUP_YB_ROCKSDB_DIR={{ tack_backup_yb_rocksdb_dir }}
TACK_BACKUP_YB_OVERLAY_PATH={{ tack_backup_yb_overlay_path }}
# FoundationDB continuous backup, rendered true only on the guest that hosts
# the cluster. With it true, provision idempotently starts the streaming
# fdbbackup session, and the restore drill and staleness check exercise their
# FoundationDB legs; the long-lived fdb-backup-agent compose service (backup
# profile) drains it to the object store. The overlay path is the patched
# fdb.bash the deploy fetches onto this guest, which the restore drill
# bind-mounts into its throwaway cluster so that cluster boots on the IPv6-only
# bridge.
#
# The owner gate is what keeps the alarm honest. Only the owner runs fdb, so a
# data guest rendering this true would run a staleness check that finds no
# cluster, report the restorable point as unknown, and mail a stale-backup
# alarm that measures nothing. The staleness check runs on a data guest by
# design, so that alarm would repeat every cycle.
TACK_BACKUP_FDB_CONTINUOUS={{ (tack_backup_fdb_continuous and tack_provision_owner) | bool | string | lower }}
TACK_BACKUP_FDB_OVERLAY_PATH={{ tack_backup_fdb_overlay_path }}
# Backup staleness alarm mail. A staleness-check run that finds any mechanism
# past its threshold mails the report it printed to this address and still exits
# nonzero. The msmtprc path is the guest's SMTP account file, bind-mounted into
# the tack-ops container read-only; the check parses it and speaks SMTP itself,
# so no msmtp binary is involved.
TACK_BACKUP_ALARM_EMAIL={{ tack_alarm_email_recipient }}
TACK_BACKUP_ALARM_MSMTPRC=/etc/msmtprc
{% if tack_cluster_role == 'data' %}
# The data-guest copy of the staleness alarm is a deputy (TACK-481): before it
# mails a new fault it looks in the audit ledger for the owner's own check,
# recorded under the owner's --operator-service name, within the window. A
# fresh owner run means the owner mails and the deputy logs that it deferred,
# so one fault is one email; no run, a stale run, or an unreadable ledger
# means the deputy mails. The owner renders no primary service and is the
# primary. The deputy's unit runs under tack-backup-deputy so the two checks
# record under different actors.
TACK_BACKUP_ALARM_PRIMARY_SERVICE=tack-backup
{% endif %}
{% endif %}
