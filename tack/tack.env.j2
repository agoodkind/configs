# Tack environment file, rendered by Ansible from tack/tack.env.j2 at deploy
# time. Secret values come from vault_* variables in
# ansible/inventory/group_vars/all/vault.yml (encrypted); non-secret values come
# from the tack group_vars. Nothing here is hand-edited on the host.

# Container image tag. Production uses latest; QA pins a branch build by passing
# tack_image_tag at deploy. Declared in group_vars (tack_all).
TACK_IMAGE_TAG={{ tack_image_tag }}

# YugabyteDB credentials
YUGABYTE_USER={{ tack_yugabyte_user }}
YUGABYTE_DB={{ tack_yugabyte_db }}
YUGABYTE_PASSWORD={{ tack_yugabyte_password }}

# Meilisearch master key
MEILI_MASTER_KEY={{ tack_meili_master_key }}

# Audit ledger DSNs and passwords.
# Each DSN is a full postgres:// URL pointing at the yugabyte service.
# The password component must match the corresponding _PASSWORD variable
# so that seed-audit-roles can create or rotate the role credentials.
AUDIT_WRITER_PASSWORD={{ tack_audit_writer_password }}
AUDIT_READER_PASSWORD={{ tack_audit_reader_password }}
AUDIT_REDACTOR_PASSWORD={{ tack_audit_redactor_password }}
AUDIT_OPERATOR_PASSWORD={{ tack_audit_operator_password }}
{# Repointed environments dial the three data nodes by name with driver
   failover; legacy environments dial the local yugabyte service, because
   their data guests are not provisioned and the multi-host names would
   resolve nowhere. Every multi-host string carries the connect bound: a
   node that goes silent otherwise costs each of these pools minutes per
   host before the driver moves on, which is the request-path form of the
   health-check stall TACK-464 fixed. #}
{% if tack_ledger_consumers_repointed %}
AUDIT_WRITER_DSN=postgres://tack_audit_writer:{{ tack_audit_writer_password }}@yb1:5433,yb2:5433,yb3:5433/{{ tack_yugabyte_db }}?sslmode=disable&connect_timeout={{ tack_database_connect_timeout_seconds }}
AUDIT_READER_DSN=postgres://tack_audit_reader:{{ tack_audit_reader_password }}@yb1:5433,yb2:5433,yb3:5433/{{ tack_yugabyte_db }}?sslmode=disable&connect_timeout={{ tack_database_connect_timeout_seconds }}
AUDIT_REDACTOR_DSN=postgres://tack_audit_redactor:{{ tack_audit_redactor_password }}@yb1:5433,yb2:5433,yb3:5433/{{ tack_yugabyte_db }}?sslmode=disable&connect_timeout={{ tack_database_connect_timeout_seconds }}
{% else %}
AUDIT_WRITER_DSN=postgres://tack_audit_writer:{{ tack_audit_writer_password }}@yugabyte:5433/{{ tack_yugabyte_db }}?sslmode=disable
AUDIT_READER_DSN=postgres://tack_audit_reader:{{ tack_audit_reader_password }}@yugabyte:5433/{{ tack_yugabyte_db }}?sslmode=disable
AUDIT_REDACTOR_DSN=postgres://tack_audit_redactor:{{ tack_audit_redactor_password }}@yugabyte:5433/{{ tack_yugabyte_db }}?sslmode=disable
{% endif %}

# Operator command audit outbox (TACK-328). Every mutating operator command
# records an intent row before it runs and an outcome row after, through the
# non-superuser operator role. With this DSN unset every audited command
# refuses to run, so it is required, not optional. The tack-ops sidecar runs
# host-networked and reaches the database at the guest that serves it, like
# tack_ops_database_url: the guest publishes 5433 on the IPv6 wildcard only,
# so the IPv4 loopback is refused and provision cannot record.
{% if tack_ledger_consumers_repointed %}
AUDIT_OPERATOR_DSN=postgres://tack_audit_operator:{{ tack_audit_operator_password }}@yb1:5433,yb2:5433,yb3:5433/{{ tack_yugabyte_db }}?sslmode=disable&connect_timeout={{ tack_database_connect_timeout_seconds }}
{# Keyword form: the URL form rejects a comma list of bracketed IPv6 hosts. #}
TACK_OPS_AUDIT_OPERATOR_DSN=host={{ tack_ledger_node_addresses.yb1 }},{{ tack_ledger_node_addresses.yb2 }},{{ tack_ledger_node_addresses.yb3 }} port=5433 user=tack_audit_operator password={{ tack_audit_operator_password }} dbname={{ tack_yugabyte_db }} sslmode=disable connect_timeout={{ tack_database_connect_timeout_seconds }}

# Ledger read and redaction for the host-side audit query, get, export, and
# redact-actor commands. Same host-networked keyword form as the operator DSN.
TACK_OPS_AUDIT_READER_DSN=host={{ tack_ledger_node_addresses.yb1 }},{{ tack_ledger_node_addresses.yb2 }},{{ tack_ledger_node_addresses.yb3 }} port=5433 user=tack_audit_reader password={{ tack_audit_reader_password }} dbname={{ tack_yugabyte_db }} sslmode=disable connect_timeout={{ tack_database_connect_timeout_seconds }}
TACK_OPS_AUDIT_REDACTOR_DSN=host={{ tack_ledger_node_addresses.yb1 }},{{ tack_ledger_node_addresses.yb2 }},{{ tack_ledger_node_addresses.yb3 }} port=5433 user=tack_audit_redactor password={{ tack_audit_redactor_password }} dbname={{ tack_yugabyte_db }} sslmode=disable connect_timeout={{ tack_database_connect_timeout_seconds }}
{% else %}
AUDIT_OPERATOR_DSN=postgres://tack_audit_operator:{{ tack_audit_operator_password }}@yugabyte:5433/{{ tack_yugabyte_db }}?sslmode=disable
TACK_OPS_AUDIT_OPERATOR_DSN=postgres://tack_audit_operator:{{ tack_audit_operator_password }}@[{{ tack_store_host }}]:5433/{{ tack_yugabyte_db }}?sslmode=disable

# Ledger read and redaction for the host-side audit query, get, export, and
# redact-actor commands. Same store-host shape as the operator DSN above.
TACK_OPS_AUDIT_READER_DSN=postgres://tack_audit_reader:{{ tack_audit_reader_password }}@[{{ tack_store_host }}]:5433/{{ tack_yugabyte_db }}?sslmode=disable
TACK_OPS_AUDIT_REDACTOR_DSN=postgres://tack_audit_redactor:{{ tack_audit_redactor_password }}@[{{ tack_store_host }}]:5433/{{ tack_yugabyte_db }}?sslmode=disable
{% endif %}

# Path to the Ed25519 audit signing key on the host.
# Generated once per host with:
#   openssl genpkey -algorithm ed25519 -out /etc/tack/audit-signing.pem
# QA and production MUST use separate keys; sharing keys collapses the
# audit ledger's compliance claim.
AUDIT_SIGNING_KEY_PATH={{ tack_audit_signing_key_path }}

# Audit cutover (TACK-232 Phase C). The audit profile starts kafka, clickhouse,
# and the audit-consumer. The app produces audit events to Kafka, the
# audit-consumer becomes the only writer of audit.events, and ClickHouse is the
# analytical read tier for tack_audit_query.
#
# The backup profile is added on backup-enabled hosts so deploy keeps the
# long-lived fdb-backup-agent running; the FoundationDB continuous backup needs
# a persistent backup_agent to reach a restorable snapshot.
COMPOSE_PROFILES={{ 'audit,backup' if tack_backup_enabled | bool else 'audit' }}
AUDIT_KAFKA_BROKERS=kafka:9092
KAFKA_CLUSTER_ID={{ tack_kafka_cluster_id }}
AUDIT_CLICKHOUSE_DSN=clickhouse://default:@clickhouse:9000/default
AUDIT_CONSUMER_CLICKHOUSE_DSN=clickhouse://default:@clickhouse:9000/default

# FoundationDB half of the operator audit relay (TACK-328). Opt-in by design:
# a set-but-unreadable cluster file makes the audit-consumer refuse to start,
# which would also halt the YugabyteDB relay and every operator event with it.
# Both deployed hosts mount the cluster file, so both set it.
AUDIT_CONSUMER_FDB_CLUSTER_FILE=/etc/foundationdb/fdb.cluster

# QA data-generator write marker (TACK-338). `ops qa datagen` refuses to write
# unless this is exactly qa or local, so QA sets it and production renders it
# empty. The generator runs through the app service, which reaches FoundationDB
# and holds the audit DSNs.
TACK_DATAGEN_ALLOW_TARGET={{ tack_datagen_allow_target }}

# tack-ops sidecar database URL.
# The ops container runs on host networking and connects to the Yugabyte
# YSQL port on the loopback address of the host (port 5433 is published).
TACK_OPS_DATABASE_URL={{ tack_ops_database_url }}

# Logging
LOG_LEVEL={{ tack_log_level }}
LOG_MAX_BACKUPS={{ tack_log_max_backups }}
LOG_MAX_AGE_DAYS={{ tack_log_max_age_days }}
LOG_MAX_SIZE_MB={{ tack_log_max_size_mb }}

# FDB version (must match the Go bindings pin in go.mod and Makefile).
FDB_VERSION={{ tack_fdb_version }}

# HTTP port the app listens on inside the container.
PORT={{ tack_port }}

# Docker IPv6 bridge subnet and gateway, per host. docker-compose.yml reads
# these for networks.default. The NDP proxy prefix (tack_ndp_proxy_prefix) must
# match the subnet.
TACK_DOCKER_V6_SUBNET={{ tack_docker_v6_subnet }}
TACK_DOCKER_V6_GATEWAY={{ tack_docker_v6_gateway }}

# Backup object store (S3-compatible). Rendered only when tack_backup_enabled is
# true (a host with an object store); other hosts omit the whole block instead of
# writing empty values. Only the ops backup commands read these, never the
# request path.
{% if tack_backup_enabled | bool %}
TACK_BACKUP_S3_ENDPOINT={{ tack_backup_s3_endpoint }}
# Bare object-store host, no scheme or port, for the fdb-backup-agent's
# fdb-blobstore-host mapping, because fdbbackup cannot resolve an IPv6 literal.
TACK_BACKUP_S3_HOST={{ tack_backup_s3_host }}
TACK_BACKUP_S3_ACCESS_KEY_ID={{ tack_backup_s3_access_key }}
TACK_BACKUP_S3_SECRET_ACCESS_KEY={{ tack_backup_s3_secret_key }}
TACK_BACKUP_S3_REGION={{ tack_backup_s3_region }}
TACK_BACKUP_S3_BUCKET_MAIN={{ tack_backup_s3_bucket_main }}
# Master quorum for the backup one-shot containers; derived in group_vars
# from the ledger topology (local service name while the legacy node
# exists, the data guests' pinned addresses after retirement).
TACK_BACKUP_YB_MASTER_ADDRESSES={{ tack_backup_yb_master_addresses }}
# Snapshot-export paths: the rocksdb root inside the ledger container
# holding the per-tablet snapshot directories, and the host path of the
# patched yugabyted the restore drill bind-mounts.
TACK_BACKUP_YB_ROCKSDB_DIR={{ tack_backup_yb_rocksdb_dir }}
TACK_BACKUP_YB_OVERLAY_PATH={{ tack_backup_yb_overlay_path }}
# FoundationDB continuous backup, rendered true only on the guest that hosts
# the cluster. With it true, provision idempotently starts the streaming
# fdbbackup session, and the restore drill and staleness check exercise their
# FoundationDB legs; the long-lived fdb-backup-agent compose service (backup
# profile) drains it to the object store. The overlay path is the patched
# fdb.bash the deploy fetches onto this guest, which the restore drill
# bind-mounts into its throwaway cluster so that cluster boots on the IPv6-only
# bridge.
#
# The owner gate is what keeps the alarm honest. Only the owner runs fdb, so a
# data guest rendering this true would run a staleness check that finds no
# cluster, report the restorable point as unknown, and mail a stale-backup
# alarm that measures nothing. The staleness check runs on a data guest by
# design, so that alarm would repeat every cycle.
TACK_BACKUP_FDB_CONTINUOUS={{ (tack_backup_fdb_continuous and tack_provision_owner) | bool | string | lower }}
TACK_BACKUP_FDB_OVERLAY_PATH={{ tack_backup_fdb_overlay_path }}
# Backup staleness alarm mail. A staleness-check run that finds any mechanism
# past its threshold mails the report it printed to this address and still exits
# nonzero. The msmtprc path is the guest's SMTP account file, bind-mounted into
# the tack-ops container read-only; the check parses it and speaks SMTP itself,
# so no msmtp binary is involved.
TACK_BACKUP_ALARM_EMAIL={{ tack_alarm_email_recipient }}
TACK_BACKUP_ALARM_MSMTPRC=/etc/msmtprc
{% endif %}
