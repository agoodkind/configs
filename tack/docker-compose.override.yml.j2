# Rendered by Ansible from tack/docker-compose.override.yml.j2 at deploy time.
# Compose merges this file over docker-compose.yml automatically. Only final
# values appear here, so the file on the guest reads exactly as it runs.
#
# The ledger engine persists the announced identity in its internal catalog,
# so each node announces a permanent name and never an address. The hostname
# maps this node's own name to its container address; extra_hosts map every
# other ledger name to the owning guest's pinned address, reached on the
# published node ports.
services:
{% if tack_cluster_role == 'search' %}
  # This service is the guest's OpenSearch member (TACK-539). A search guest
  # runs no ledger node, and this is the only service its override defines.
  # The service uses host networking because a container address changes on
  # every recreate. The node announces the guest's pinned address to its
  # peers, and the proxy dials that address.
  opensearch:
    image: {{ tack_search_image }}
    network_mode: host
    environment:
      OPENSEARCH_JAVA_OPTS: "{{ tack_search_java_opts }}"
      DISABLE_INSTALL_DEMO_CONFIG: "true"
      cluster.name: {{ tack_search_cluster_name }}
      # This map omits node.name and the discovery keys because the Tack base
      # file sets node.name, discovery.type, discovery.seed_hosts, and
      # cluster.initial_cluster_manager_nodes from the TACK_SEARCH_* values in
      # the rendered .env. Compose merges this map with the opensearch
      # environment in the base file.
{% if tack_search_node_roles == '' %}
      # A coordinating-only member has no role. OpenSearch refuses an empty -E
      # value, and the image entrypoint passes no empty setting. This empty
      # value replaces the base file's role list, and the mounted
      # opensearch.yml below sets node.roles to an empty list.
{% endif %}
      node.roles: "{{ tack_search_node_roles }}"
      network.host: "{{ service_mapping[service_name].ipv6 }}"
      http.port: "{{ tack_search_port }}"
      # Every member refuses to create a node-pages-* index automatically
      # because Tack creates each one with an explicit mapping. Tack does not
      # change this setting at runtime.
      action.auto_create_index: "-node-pages-*,+*"
      # Only ML nodes run model work. OpenSearch dispatches each task to the
      # least-loaded ML node and redeploys the model after a node restarts or
      # joins.
      plugins.ml_commons.only_run_on_ml_node: "true"
      plugins.ml_commons.task_dispatch_policy: least_load
      plugins.ml_commons.model_auto_redeploy.enable: "true"
      # The HTTP and transport layers both use TLS with this member's
      # certificate, and each side verifies the other against the search
      # authority. A peer joins only when its certificate subject matches a
      # member hostname. The first start creates the security index from the
      # mounted user, role, and role mapping files. The HTTP layer also trusts
      # the self-signed admin certificate, and a request that presents it is a
      # super admin request. The deploy uses that certificate to write changed
      # security files into the running member.
      plugins.security.ssl.http.enabled: "true"
      plugins.security.ssl.http.pemcert_filepath: tack-search/node.crt
      plugins.security.ssl.http.pemkey_filepath: tack-search/node.key
      plugins.security.ssl.http.pemtrustedcas_filepath: tack-search/http-ca.crt
      plugins.security.authcz.admin_dn: "{{ tack_search_admin_dn }}"
      plugins.security.ssl.transport.pemcert_filepath: tack-search/node.crt
      plugins.security.ssl.transport.pemkey_filepath: tack-search/node.key
      plugins.security.ssl.transport.pemtrustedcas_filepath: tack-search/ca.crt
      plugins.security.nodes_dn: "{{ tack_search_members | map('extract', service_mapping, 'hostname') | map('regex_replace', '^', 'CN=') | join(',') }}"
      plugins.security.allow_default_init_securityindex: "true"
    volumes:
      - opensearch-data:/usr/share/opensearch/data
      - {{ tack_search_node_dir }}/node.crt:/usr/share/opensearch/config/tack-search/node.crt:ro
      - {{ tack_search_node_dir }}/node.key:/usr/share/opensearch/config/tack-search/node.key:ro
      - {{ tack_search_ca_path }}:/usr/share/opensearch/config/tack-search/ca.crt:ro
      - {{ tack_search_node_dir }}/http-ca.crt:/usr/share/opensearch/config/tack-search/http-ca.crt:ro
      - {{ tack_search_node_dir }}/internal_users.yml:/usr/share/opensearch/config/opensearch-security/internal_users.yml:ro
      - {{ tack_search_node_dir }}/roles.yml:/usr/share/opensearch/config/opensearch-security/roles.yml:ro
      - {{ tack_search_node_dir }}/roles_mapping.yml:/usr/share/opensearch/config/opensearch-security/roles_mapping.yml:ro
    ulimits:
      nofile:
        soft: {{ tack_search_nofile_limit }}
        hard: {{ tack_search_nofile_limit }}
{% if tack_search_node_roles == '' %}
    configs:
      - source: opensearch-coordinating-node
        target: /usr/share/opensearch/config/opensearch.yml
{% endif %}
{% endif %}
{% if tack_store_node_present | bool %}
  # The product store on this data guest (TACK-408). Host networking, because
  # the process has to bind the address it announces: the cluster records that
  # address, a client dials it from another guest, and a container address is
  # replaced on the next recreate. The pinned address, the fault domain, and
  # the seeded coordinator list are rendered into .env beside this file.
  fdb:
    network_mode: host
{% endif %}
{% if tack_provision_owner and not tack_store_legacy_node_present %}
  # Retired on this guest: the store runs one process per data guest, and the
  # inactive profile keeps every compose up from starting one here. The deploy
  # removes the stopped containers. Retire only after `ops store exclude` has
  # moved every copy of a key off this guest's process, which the migration
  # plan does before this value flips. The stack file gives the backup agent
  # the backup profile, which COMPOSE_PROFILES enables, and compose starts a
  # service when any one of its profiles is active. The override replaces the
  # list instead of adding to it.
  fdb:
    profiles: !override ["retired"]
  fdb-backup-agent:
    profiles: !override ["retired"]
{% endif %}
{% if (tack_provision_owner or tack_app_guest | bool) and tack_ledger_consumers_repointed %}
  # The app and the audit consumer reach the ledger at its permanent node
  # names, which resolve here to the owning guests' pinned addresses. The
  # multi-host database URL fails over across the three data nodes, so
  # retiring the node on this guest does not cut the app off from SQL.
  # Secrets stay compose interpolations from .env, never rendered values.
  # Gated on the environment's repoint switch: an owner whose consumers
  # still dial the legacy node keeps the base file's local URL, because
  # its data guests are not provisioned and these names resolve nowhere.
  #
  # connect_timeout bounds each name in that list. Losing a data guest
  # black-holes its socket rather than refusing it, so without the bound
  # the driver waits out the kernel's TCP retry on yb1 and never reaches
  # yb2 or yb3 (TACK-464).
  app:
    extra_hosts:
{% for peer_name, peer_address in tack_ledger_peers.items() %}
      - "{{ peer_name }}:{{ peer_address }}"
{% endfor %}
    environment:
      DATABASE_URL: postgres://tack_app:${TACK_APP_PASSWORD:?}@yb1:5433,yb2:5433,yb3:5433/${YUGABYTE_DB:?}?{{ tack_ledger_ssl_query }}&connect_timeout={{ tack_database_connect_timeout_seconds }}
{% endif %}
{% if tack_provision_owner and tack_ledger_consumers_repointed %}
  audit-consumer:
    extra_hosts:
{% for peer_name, peer_address in tack_ledger_peers.items() %}
      - "{{ peer_name }}:{{ peer_address }}"
{% endfor %}
{% endif %}
{% if tack_provision_owner and tack_queue_external_listener_enabled | bool %}
  # The broker keeps its bridge listener for the services on this guest and
  # adds a listener that the application-only guests dial on this guest's
  # pinned address (TACK-544). The three values repeat the Tack base file's
  # PLAINTEXT and CONTROLLER entries because compose replaces an environment
  # value instead of appending to it. Compose publishes the port on the guest
  # address, and the tack_queue firewall table on this guest accepts it only
  # from the guests in tack_queue_external_clients.
  kafka:
    ports:
      - "{{ tack_queue_external_port }}:{{ tack_queue_external_port }}"
    environment:
      KAFKA_LISTENERS: "PLAINTEXT://[::]:9092,CONTROLLER://[::]:9093,EXTERNAL://[::]:{{ tack_queue_external_port }}"
      KAFKA_ADVERTISED_LISTENERS: "PLAINTEXT://kafka:9092,EXTERNAL://[{{ service_mapping[service_name].ipv6 }}]:{{ tack_queue_external_port }}"
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT"
{% endif %}
{% if tack_cluster_role != 'search' and not tack_app_guest | bool %}
  yugabyte:
{% if tack_provision_owner and not tack_ledger_legacy_node_present %}
    # Retired on this guest: the inactive profile keeps every compose up
    # from starting the service here, and the deploy's --remove-orphans
    # removes the stopped container. The data guests keep their nodes.
    profiles: ["retired"]
{% endif %}
    hostname: {{ tack_ledger_node_name }}
    extra_hosts:
{% for peer_name, peer_address in tack_ledger_peers.items() %}
      - "{{ peer_name }}:{{ peer_address }}"
{% endfor %}
{% if tack_ledger_tls_enabled %}
    # This node's own certificate and the authority that issued it
    # (TACK-460), read-only: the engine presents node.{{ tack_ledger_node_name }}.crt to
    # clients and to its peers, and checks theirs against ca.crt in the same
    # directory. The deploy issues the material; nothing here writes it.
    volumes:
      - {{ tack_ledger_certs_dir }}:/home/yugabyte/certs:ro
{% endif %}
    # Whole-command replacement: compose replaces a command list wholesale.
    # Only the announced name and the join target differ from the base file;
    # the flagfile argument stays verbatim, because dropping it reverts the
    # tserver to self-sizing (the 2026-08-05 incident).
    command:
      - /home/yugabyte/bin/yugabyted
      - start
      - --daemon=false
      - --base_dir=/home/yugabyte/var
      - --advertise_address={{ tack_ledger_node_name }}
      - --listen={{ tack_ledger_node_name }}
{% if tack_ledger_join_target %}
      # First start enrolls into the cluster at the join target; without it
      # the engine bootstraps a second universe instead of joining.
      - --join={{ tack_ledger_join_target }}
{% endif %}
{% if tack_ledger_tls_enabled %}
      # Encryption in transit, both directions (TACK-460). The engine
      # encrypts peer traffic and client traffic and refuses an unencrypted
      # connection, so a client that skipped its certificate is turned away
      # rather than served in the clear. The flags go on both processes
      # because the masters speak to each other on their own port. The
      # tserver list keeps the flagfile first: dropping it reverts the
      # tserver to self-sizing (the 2026-08-05 incident).
      - --master_flags=certs_dir=/home/yugabyte/certs,use_node_to_node_encryption=true,use_client_to_server_encryption=true,certs_for_client_dir=/home/yugabyte/certs,allow_insecure_connections=false
      - --tserver_flags=flagfile=/home/yugabyte/tserver.flags,certs_dir=/home/yugabyte/certs,use_node_to_node_encryption=true,use_client_to_server_encryption=true,certs_for_client_dir=/home/yugabyte/certs,allow_insecure_connections=false
{% else %}
      - --tserver_flags=flagfile=/home/yugabyte/tserver.flags
{% endif %}
{% elif tack_cluster_role == 'search' %}

volumes:
  opensearch-data:
{% if tack_search_node_roles == '' %}

# The OpenSearch 3.8.0 image default opensearch.yml sets cluster.name and
# network.host; the environment above sets both again, and an -E setting
# takes precedence over this file. The file adds the empty role list.
configs:
  opensearch-coordinating-node:
    content: |
      cluster.name: docker-cluster
      network.host: 0.0.0.0
      node.roles: []
{% endif %}
{% endif %}
