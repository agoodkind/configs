#!/usr/bin/env bash
# Build connection strings in protected files on the service host.
set -euo pipefail
umask 077

readonly SECRET_DIR={{ tack_secrets_dir | quote }}
readonly DATABASE={{ tack_yugabyte_db | quote }}
readonly SSL_QUERY={{ tack_ledger_ssl_query | quote }}
readonly SSL_KEYWORDS={{ tack_ledger_ssl_keywords | quote }}
readonly CONNECT_TIMEOUT={{ tack_database_connect_timeout_seconds | string | quote }}
readonly OPS_HOSTS={{ ([tack_ledger_node_addresses.yb1, tack_ledger_node_addresses.yb2, tack_ledger_node_addresses.yb3] | join(',')) | quote }}
readonly STORE_HOST={{ tack_store_host | quote }}
SECRET_VALUE=''

read_secret() {
    local name="$1"
    local lines=()
    mapfile -t lines <"${SECRET_DIR}/${name}"
    if [[ -z "${lines[0]-}" || -v 'lines[1]' ]]; then
        printf 'Credential file %s must contain one nonempty line.\n' "${SECRET_DIR}/${name}" >&2
        exit 1
    fi
    SECRET_VALUE="${lines[0]}"
}

encode_uri_password() {
    local LC_ALL=C
    local password="$SECRET_VALUE"
    local character
    SECRET_VALUE=''
    # Encode each byte outside the URI unreserved character set.
    while [[ -n "$password" ]]; do
        character="${password:0:1}"
        password="${password:1}"
        case "$character" in
            [a-zA-Z0-9.~_-]) SECRET_VALUE+="$character" ;;
            *) printf -v SECRET_VALUE '%s%%%02X' "$SECRET_VALUE" "'$character" ;;
        esac
    done
}

write_dsn() {
    local name="$1"
    local login="$2"
    local password_name="$3"
    local hosts="$4"
    local password
    read_secret "$password_name"
    encode_uri_password
    password="$SECRET_VALUE"
    printf 'postgres://%s:%s@%s/%s?%s&connect_timeout=%s\n' \
        "$login" "$password" "$hosts" "$DATABASE" "$SSL_QUERY" "$CONNECT_TIMEOUT" >"${SECRET_DIR}/${name}"
    chmod 0600 "${SECRET_DIR}/${name}"
}

write_operator_dsn() {
    local name="$1"
    local login="$2"
    local password_name="$3"
    local password
    read_secret "$password_name"
    password="$SECRET_VALUE"
{% if tack_ledger_consumers_repointed %}
    password="${password//\\/\\\\}"
    password="${password//\'/\\\'}"
    password="'${password}'"
    printf 'host=%s port=5433 user=%s password=%s dbname=%s %s connect_timeout=%s\n' \
        "$OPS_HOSTS" "$login" "$password" "$DATABASE" "$SSL_KEYWORDS" "$CONNECT_TIMEOUT" >"${SECRET_DIR}/${name}"
{% else %}
    write_dsn "$name" "$login" "$password_name" "[${STORE_HOST}]:5433"
{% endif %}
    chmod 0600 "${SECRET_DIR}/${name}"
}

{% if tack_ledger_consumers_repointed %}
readonly SERVICE_HOSTS='yb1:5433,yb2:5433,yb3:5433'
{% else %}
readonly SERVICE_HOSTS='yugabyte:5433'
{% endif %}
{% if tack_provision_owner | bool or tack_app_guest | bool %}
write_dsn DATABASE_URL tack_app TACK_APP_PASSWORD "$SERVICE_HOSTS"
{% endif %}
{% if tack_provision_owner | bool %}
read_secret CLICKHOUSE_PASSWORD
encode_uri_password
printf 'clickhouse://tack_audit_consumer:%s@clickhouse:9000/audit\n' "$SECRET_VALUE" >"${SECRET_DIR}/AUDIT_CONSUMER_CLICKHOUSE_DSN"
chmod 0600 "${SECRET_DIR}/AUDIT_CONSUMER_CLICKHOUSE_DSN"
{% endif %}
{% if tack_provision_owner | bool or tack_ledger_bootstrap | bool %}
for role in WRITER READER REDACTOR OPERATOR; do
    login="tack_audit_${role,,}"
    write_dsn "AUDIT_${role}_DSN" "$login" "AUDIT_${role}_PASSWORD" "$SERVICE_HOSTS"
done
{% if tack_provision_owner | bool %}
cp "${SECRET_DIR}/AUDIT_WRITER_DSN" "${SECRET_DIR}/AUDIT_CONSUMER_YUGABYTE_DSN"
{% endif %}
{% elif tack_app_guest | bool %}
write_dsn AUDIT_OPERATOR_DSN tack_audit_operator AUDIT_OPERATOR_PASSWORD "$SERVICE_HOSTS"
{% endif %}
write_operator_dsn TACK_OPS_AUDIT_OPERATOR_DSN tack_audit_operator AUDIT_OPERATOR_PASSWORD
{% if not tack_app_guest | bool %}
{% if tack_provision_owner | bool or tack_ledger_bootstrap | bool %}
for role in READER REDACTOR; do
{% else %}
for role in READER; do
{% endif %}
    login="tack_audit_${role,,}"
    write_operator_dsn "TACK_OPS_AUDIT_${role}_DSN" "$login" "AUDIT_${role}_PASSWORD"
done
{% if tack_provision_owner | bool or tack_ledger_bootstrap | bool %}
write_operator_dsn TACK_LEDGER_SUPERUSER_DATABASE_URL {{ tack_yugabyte_user | quote }} YUGABYTE_PASSWORD
{% endif %}
{% if tack_ops_use_migrator | bool %}
write_operator_dsn TACK_OPS_DATABASE_URL tack_migrator TACK_MIGRATOR_PASSWORD
{% else %}
write_operator_dsn TACK_OPS_DATABASE_URL {{ tack_yugabyte_user | quote }} YUGABYTE_PASSWORD
{% endif %}
{% endif %}
