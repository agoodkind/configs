# Astound WAN Interface (virtio, testbed only, no prod counterpart)
# Generated by Ansible

[Match]
Name={{ mwan_astound_iface }}

[Network]
# A dynamic IPv4-only link: DHCPv4 for the address. The real Astound circuit
# carries no IPv6, so this link requests no DHCPv6 lease, no prefix
# delegation, and accepts no router advertisements.
DHCP=ipv4
IPv6AcceptRA=no

# Needed for policy routing / forwarding
IPv4Forwarding=yes

[DHCPv4]
# The least preferred provider on the testbed, below monkeybrains at 5000, so a
# kernel default route from this link never outranks one from another.
RouteMetric=6000
