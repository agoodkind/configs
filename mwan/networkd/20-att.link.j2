# AT&T WAN Interface (X710 VF passthrough, iavf driver)
# Generated by Ansible
# NOTE: testbed counterpart at mwan/networkd/testbed/20-att.link.j2 (matches by MAC, no EAP). Edit both.
# Matches on iavf driver, assigns name eth1 and spoofs MAC for AT&T auth
# This interface is so that WPA can be run
# Once authenticated, AT&T will immediately put traffic on to vlan03242
# therefore we do not need an att network file, only the att vlan 3242 file

# This file must match only the AT&T NIC and never a NIC that mwan controls.
# The VF has the first MAC on its first boot and the second MAC on later boots.
[Match]
Driver=iavf
PermanentMACAddress={{ mwan_att_vf_host_mac | lower }} {{ mwan_att_eap_identity | lower }}

[Link]
Name={{ mwan_att_iface }}
# Set MAC for AT&T authentication
MACAddress={{ mwan_att_eap_identity }}
