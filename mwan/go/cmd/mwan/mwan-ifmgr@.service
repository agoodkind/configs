[Unit]
Description=MWAN ifmgr (interface manager) daemon for role %i
Documentation=https://github.com/agoodkind/configs
# The daemon runs before udev's coldplug trigger and networkd because it writes
# the provider .link files, and udev reads a .link file only when the device
# appears.
DefaultDependencies=no
# No ordering after local-fs.target: that target waits for the /boot/efi
# device, which the coldplug trigger creates, and the boot stalls 90 seconds.
# Ordering after systemd-remount-fs.service keeps /var/lib/mwan writable,
# because ProtectSystem=strict fixes the mounts as they are at start and the
# root filesystem is read-only until that service runs. That service waits only
# for the journal socket and the root filesystem check.
After=systemd-journald.socket systemd-remount-fs.service
Before=systemd-udev-trigger.service systemd-networkd.service shutdown.target
# Conflicts= is stated because DefaultDependencies=no drops the implicit
# shutdown ordering.
Conflicts=shutdown.target

[Service]
Type=simple
# Role is selected by the systemd instance name.
#
# EnvironmentFile is optional. Ansible renders /etc/mwan/secrets.env with
# SMTP2GO_API_KEY when the host has email configured. The leading dash
# tells systemd to start the unit even when the file is absent.
EnvironmentFile=-/etc/mwan/secrets.env
ExecStart=/usr/local/bin/mwan ifmgr --role %i
Restart=always
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mwan-ifmgr@%i

# The daemon needs:
#   CAP_NET_ADMIN        - addr/rule/route mutations via netlink
#   CAP_NET_RAW          - ICMPv6 sockets for NDP and connectivity probes,
#                          plus DHCPv4 raw sockets (insomniacslk/dhcp)
#   CAP_NET_BIND_SERVICE - reserved for any future low-port bind
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# Lock down the rest of the filesystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
# PrivateTmp is absent because it orders the unit after
# systemd-tmpfiles-setup.service, and that ordering stalls the boot 90 seconds:
# the service waits for local-fs.target, which waits for the /boot/efi device
# the coldplug trigger creates. The daemon writes nothing under /tmp.

# ProtectKernelTunables: vault keeps the default true since its oob
# instance does not need to write any sysctls. The failover role uses
# slaac_health, which writes net.ipv6.conf.<iface>.disable_ipv6, and the
# suburban hypervisor's oob instance enables host_ipv6_policy, which
# writes net.ipv6.conf.<iface>.accept_ra, autoconf, and
# accept_ra_defrtr. Those deployments MUST relax this via a drop-in:
#
#   # /etc/systemd/system/mwan-ifmgr.service.d/lxc-failover.conf
#   [Service]
#   ProtectKernelTunables=false
#   ReadWritePaths=/var/log /var/run /run /proc/sys/net/ipv6/conf
#
# This default keeps prod vault locked down by default and forces an
# explicit, reviewable change to relax it.
ProtectKernelTunables=true
# The health persist mirror needs restart-recovery state under /var/lib/mwan.
# The wanconfig publish opens a sysrepo connection, which writes lock and
# state files under the repository directory; the leading dash skips the
# entry on hosts without the wanconfig stack (sysrepo's shared memory under
# /dev/shm is already writable, since ProtectSystem leaves /dev alone).
#
# StateDirectory is absent because it orders the unit after
# systemd-tmpfiles-setup.service, and that ordering stalls the boot 90 seconds:
# the service waits for local-fs.target, which waits for the /boot/efi device
# the coldplug trigger creates. A tmpfiles rule creates /var/lib/mwan instead.
ReadWritePaths=/var/log /var/run /run /var/lib/mwan /etc/systemd/network -/etc/sysrepo
# The static sysrepo inside the binary follows the upstream access policy:
# repository files are group sysrepo with umask 007. The daemon joins that
# group so its files and the packaged tools' files stay mutually readable.
# deploy-mwan creates the group on every gateway; the unit fails to start
# where the group is absent.
SupplementaryGroups=sysrepo

# Allow reading SSH credentials for outbound SSH from modules like
# wg that probe remote WG endpoints. ProtectHome=true otherwise
# hides /root entirely. Read-only is sufficient: the SSH client also
# needs UserKnownHostsFile=/dev/null in its options to skip the
# known_hosts write that this read-only mount cannot satisfy.
BindReadOnlyPaths=-/root/.ssh

[Install]
WantedBy=multi-user.target
