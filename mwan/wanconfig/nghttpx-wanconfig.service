[Unit]
Description=nghttpx reverse proxy for the wanconfig RESTCONF surface
After=network-online.target rousette.service
Wants=rousette.service

[Service]
Type=simple
ExecStart=/usr/sbin/nghttpx --conf=/etc/nghttpx/wanconfig.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
