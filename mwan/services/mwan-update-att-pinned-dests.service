[Unit]
Description=Refresh nftables AT&T pinned destination set
After=network-online.target mwan-ifmgr@wan.service
Wants=network-online.target mwan-ifmgr@wan.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/update-att-pinned-dests.sh
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
