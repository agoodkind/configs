#!/usr/bin/env bash

set -euo pipefail

readonly CONFIGSCTL_PACKAGE="goodkind.io/configsctl/cmd/configsctl"
readonly CONFIGSCTL_VERSION="v0.0.0-20261106074633-91d4d977d4ec"

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  cd "$(dirname "${BASH_SOURCE[0]}")"
  exec go run "${CONFIGSCTL_PACKAGE}@${CONFIGSCTL_VERSION}" "$@"
fi
