#!/usr/bin/env bash

set -euo pipefail

readonly CONFIGSCTL_PACKAGE="goodkind.io/configsctl/cmd/configsctl"
readonly CONFIGSCTL_VERSION="v0.0.0-20261103044219-33e5d9c462ea"

# configsctl reads inventory and playbook paths relative to its working directory.
cd "$(dirname "${BASH_SOURCE[0]}")"
exec go run "${CONFIGSCTL_PACKAGE}@${CONFIGSCTL_VERSION}" "$@"
