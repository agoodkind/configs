# Rendered by Ansible (tasks/tack-backup-restore-drill.yml); cadence lives in
# the tack_all group_vars, one home.
[Unit]
Description=Rehearse recovery by restoring the Tack backups into throwaway containers
After=docker.service
# Only a drill whose every attempted leg passed writes the rehearsal marker the
# staleness check dates, so a failed drill surfaces through that check: the
# marker stops advancing and the next staleness run past the rehearsal threshold
# mails the report itself. This unit carries no OnFailure= handler, so a failed
# drill is reported on that delay rather than at the moment it fails.
#
# A failed drill retries on its own first. It boots throwaway engines and
# pulls from the object store, and a transient refusal from either used to
# cost a day, because the next attempt was the next timer tick. The unit may
# start six times in the window below: the scheduled start and five retries,
# each ten minutes after the previous attempt ends. A drill that fails fast
# is retried within the hour, and the 20 hour window bounds a drill whose
# attempts each fail slowly to six starts too. A drill that still fails after
# that is failing on something real, and the rehearsal marker stops advancing
# until it is fixed.
StartLimitIntervalSec=20h
StartLimitBurst=6

[Service]
Type=oneshot
WorkingDirectory={{ tack_install_dir }}
# --execute is the audited action gate; without it the command prints its plan
# and exits 0, so nothing would be restored and no rehearsal marker would ever
# be written. The service identity names the timer, not a human, in the
# compliance ledger (--operator-service derives a stable actor id from the name
# with no registry to seed).
ExecStart=/usr/bin/docker compose run --rm tack-ops ops backup restore-drill --execute --operator-service tack-backup
# The drill's time grows with the backups it restores, so this is not a work
# budget: the restore and scratch engine waits inside the command fail on their
# own once nothing moves for their stall windows (TACK-471). It is a backstop
# for the one step with no inactivity bound, the artifact download from the
# object store, set far past any real drill and under the daily cadence so a
# hung attempt still ends and retries before the next night's run.
TimeoutStartSec=12h
Restart=on-failure
RestartSec=10min
# A drill whose every leg passed but whose rehearsal marker did not land exits
# 3 after retrying the marker put on its own for two minutes (TACK-482). That
# is a failure of the object store, not of the restore, so the unit does not
# repeat the ten-minute double restore for it; the marker stays where it was
# and the staleness check reports it on the rehearsal threshold.
RestartPreventExitStatus=3
