[Unit]
Description=Remove expired Tack backup data
After=docker.service
StartLimitIntervalSec=20h
StartLimitBurst=6

[Service]
Type=oneshot
WorkingDirectory={{ tack_install_dir }}
ExecStart=/usr/bin/docker compose run --rm -T --no-deps tack-ops ops backup retention --keep-days {{ tack_backup_retention_days }} --execute --operator-service tack-backup
TimeoutStartSec=3600
Restart=on-failure
RestartSec=10min
