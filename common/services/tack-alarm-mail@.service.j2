# Rendered by Ansible (tasks/tack-backup-staleness.yml); the recipient lives in
# the tack_all group_vars, one home.
#
# The OnFailure= handler for a Tack alarm unit. It is a template so each failing
# unit gets its own instance, which is the only shape systemd passes
# $MONITOR_INVOCATION_ID and $MONITOR_UNIT to; every caller names it as
# tack-alarm-mail@%n.service, so the instance is the failed unit's full name.
# %i rather than %I: the instance carries dashes that %I would turn into
# slashes.
[Unit]
Description=Mail the failed run of %i to the Tack operator

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tack-alarm-mail.sh %i {{ tack_alarm_email_recipient }}
TimeoutStartSec=120
