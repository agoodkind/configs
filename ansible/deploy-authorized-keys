#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
deploy-authorized-keys

Fetch GitHub SSH keys and write an authorized_keys bundle.

Usage:
  deploy-authorized-keys --github-user <user> --out <human-bundle> \
    [--extra-pubkey <path> --extra-out <combined-bundle>]

The human bundle contains GitHub keys only. The combined bundle adds the
optional public key.
USAGE
}

die() {
    printf '%s\n' "deploy-authorized-keys: $*" >&2
    exit 1
}

cleanup() {
    if [[ -n "$HUMAN_TMP" ]]; then
        rm -f -- "$HUMAN_TMP"
    fi
    if [[ -n "$COMBINED_TMP" ]]; then
        rm -f -- "$COMBINED_TMP"
    fi
}

OUT_PATH=""
GITHUB_USER=""
EXTRA_PUBKEY=""
EXTRA_OUT=""
HUMAN_TMP=""
COMBINED_TMP=""

while [[ $# -gt 0 ]]; do
    case "$1" in
    --out)
        if [[ $# -lt 2 || -z "$2" ]]; then
            die "--out requires a value"
        fi
        OUT_PATH="$2"
        shift 2
        ;;
    --github-user)
        if [[ $# -lt 2 || -z "$2" ]]; then
            die "--github-user requires a value"
        fi
        GITHUB_USER="$2"
        shift 2
        ;;
    --extra-pubkey)
        if [[ $# -lt 2 || -z "$2" ]]; then
            die "--extra-pubkey requires a value"
        fi
        EXTRA_PUBKEY="$2"
        shift 2
        ;;
    --extra-out)
        if [[ $# -lt 2 || -z "$2" ]]; then
            die "--extra-out requires a value"
        fi
        EXTRA_OUT="$2"
        shift 2
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        die "unknown arg: $1"
        ;;
    esac
done

if [[ -z "$GITHUB_USER" ]]; then
    die "--github-user is required"
fi
if [[ -z "$OUT_PATH" ]]; then
    die "--out is required"
fi
if [[ -n "$EXTRA_PUBKEY" && -z "$EXTRA_OUT" ]]; then
    die "--extra-out is required with --extra-pubkey"
fi
if [[ -z "$EXTRA_PUBKEY" && -n "$EXTRA_OUT" ]]; then
    die "--extra-pubkey is required with --extra-out"
fi
if [[ -n "$EXTRA_PUBKEY" && ! -f "$EXTRA_PUBKEY" ]]; then
    die "extra pubkey not found: $EXTRA_PUBKEY"
fi
if [[ -n "$EXTRA_OUT" && "$OUT_PATH" == "$EXTRA_OUT" ]]; then
    die "--out and --extra-out must differ"
fi

trap cleanup EXIT

HUMAN_TMP="$(mktemp "${OUT_PATH}.tmp.XXXXXX")"
if ! curl -fsSL "https://github.com/${GITHUB_USER}.keys" |
    tr -d '\r' |
    awk 'NF { print }' |
    sort -u >"$HUMAN_TMP"; then
    die "GitHub SSH key fetch failed for $GITHUB_USER"
fi
if [[ ! -s "$HUMAN_TMP" ]]; then
    die "GitHub returned no SSH keys for $GITHUB_USER"
fi

if [[ -n "$EXTRA_PUBKEY" ]]; then
    COMBINED_TMP="$(mktemp "${EXTRA_OUT}.tmp.XXXXXX")"
    {
        awk 'NF { print }' "$HUMAN_TMP"
        tr -d '\r' <"$EXTRA_PUBKEY"
    } | awk 'NF { print }' | sort -u >"$COMBINED_TMP"
fi

mv -- "$HUMAN_TMP" "$OUT_PATH"
HUMAN_TMP=""

if [[ -n "$COMBINED_TMP" ]]; then
    mv -- "$COMBINED_TMP" "$EXTRA_OUT"
    COMBINED_TMP=""
fi
