# frozen_string_literal: true

require 'fileutils'

# Local Rake wrappers for the five canonical Ansible playbooks. Run from this
# directory (`ansible/`) or pass --working-dir; `ansible.cfg` here resolves
# inventory automatically.
#
# The deploy and check tasks run `./configsctl deploy` from the repository
# root, because that is the only sanctioned way to run a play: it gates the
# playbook's reachable files through the input-default linter, redacts every
# vault value from the output, and writes the play's output to a run log.
# configsctl reads the vault password from ~/.config/ansible/vault.pass and
# accepts no override. The play pulls the release its environment pins in
# group_vars, so no release is named on the command line.

REPOSITORY_ROOT = File.expand_path('..', __dir__)
CONFIGSCTL = './configsctl'
LOCAL_PLAYBOOKS_DIR = 'playbooks'

CANONICAL_PLAYBOOKS = {
  proxmox:   'deploy-proxmox.yml',
  mwan:      'deploy-mwan.yml',
  failover:  'deploy-mwan-failover.yml',
  opnsense:  'deploy-opnsense.yml',
  testbed:   'deploy-testbed.yml'
}.freeze

##
# Run a command from the repository root, where the `configsctl` script sits
# and from where configsctl resolves every path.
#
# @param argv [Array<String>] command and arguments
# @return [void]
def sh_in_repository_root(*argv)
  Dir.chdir(REPOSITORY_ROOT) do
    sh(*argv)
  end
end

##
# Run a canonical playbook through configsctl with optional --limit and
# --check passthrough.
#
# Tasks accept rake args: rake deploy:proxmox[vault] runs with --limit vault.
# The :check tasks add --check --diff for dry runs.
#
# configsctl is given the playbook stem, not a path: a stem resolves to
# `ansible/playbooks/<stem>.yml` for the lint gate and to
# `playbooks/<stem>.yml` for the play, while a bare `playbooks/<name>.yml`
# would resolve for the play and miss the lint gate.
#
# @param playbook [String] playbook filename
# @param limit    [String, nil] --limit target (e.g. "vault")
# @param check    [Boolean] add --check --diff
# @return [void]
def run_playbook(playbook, limit: nil, check: false)
  argv = [CONFIGSCTL, 'deploy', File.basename(playbook, '.yml')]
  argv += ['--limit', limit] if limit && !limit.empty?
  argv += ['--check', '--diff'] if check
  sh_in_repository_root(*argv)
end

namespace :deploy do
  CANONICAL_PLAYBOOKS.each do |key, playbook|
    desc "Run #{playbook} through configsctl; optional rake deploy:#{key}[<limit>]"
    task key, [:limit] do |_t, args|
      run_playbook(playbook, limit: args[:limit])
    end
  end
end

namespace :check do
  CANONICAL_PLAYBOOKS.each do |key, playbook|
    desc "Dry-run #{playbook} with --check --diff; optional rake check:#{key}[<limit>]"
    task key, [:limit] do |_t, args|
      run_playbook(playbook, limit: args[:limit], check: true)
    end
  end
end

namespace :syntax do
  CANONICAL_PLAYBOOKS.each do |key, playbook|
    desc "Syntax-check #{playbook}"
    task key do
      sh 'ansible-playbook', '--syntax-check', "#{LOCAL_PLAYBOOKS_DIR}/#{playbook}"
    end
  end

  desc 'Syntax-check every canonical playbook'
  task all: CANONICAL_PLAYBOOKS.keys.map { |k| "syntax:#{k}" }
end

desc 'Show inventory graph (proves the new layout loads)'
task :inventory do
  sh 'ansible-inventory', '--graph'
end

desc 'Lint canonical playbooks with ansible-lint'
task :lint do
  sh_in_repository_root(CONFIGSCTL, 'lint')
  CANONICAL_PLAYBOOKS.each_value do |pb|
    sh 'ansible-lint', "#{LOCAL_PLAYBOOKS_DIR}/#{pb}"
  end
end

desc 'Help: list canonical playbook shortcuts'
task :help do
  puts 'Ansible canonical playbook shortcuts. Every deploy runs ./configsctl deploy.'
  puts ''
  puts 'Run a playbook:'
  CANONICAL_PLAYBOOKS.each do |k, v|
    puts format('  rake deploy:%-9s    # %s', k, v)
  end
  puts ''
  puts 'Limit to one host (passes --limit):'
  puts '  rake deploy:proxmox[vault]'
  puts '  rake deploy:mwan[mwan.home.goodkind.io]'
  puts '  rake deploy:failover[mwan_failover_suburban_servers]'
  puts ''
  puts 'Dry-run (--check --diff):'
  puts '  rake check:proxmox[vault]'
  puts '  rake check:mwan'
  puts ''
  puts 'Syntax-check:'
  puts '  rake syntax:all'
  puts '  rake syntax:opnsense'
  puts ''
  puts 'Inventory shape (read-only):'
  puts '  rake inventory'
  puts ''
  puts 'The vault password file is ~/.config/ansible/vault.pass.'
end

task default: :help
