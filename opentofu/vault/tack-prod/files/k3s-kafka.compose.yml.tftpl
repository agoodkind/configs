networks:
  default:
    ipam:
      config:
        - subnet: ${subnet}
          ip_range: ${dynamic_range}

services:
  app:
    # Operators run "docker compose run --rm app ops ..." with the application credentials.
    profiles: [ops]
    command: ["--help"]
    restart: "no"
    ports: !reset []
  audit-consumer:
    networks:
      default:
        ipv6_address: 3d06:bad:b01:0:7ac::5
  kafka:
    restart: "no"
    environment:
      KAFKA_LISTENERS: PLAINTEXT://[::]:9092,CONTROLLER://[::]:9093,K3S://[::]:29092
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092,K3S://[${kafka_address}]:29092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,K3S:PLAINTEXT
      KAFKA_LOG_DIRS: /var/lib/kafka/data
    networks:
      default:
        ipv6_address: ${kafka_address}
    ports:
      - target: 29092
        host_ip: "::"
        protocol: tcp
