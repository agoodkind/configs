options {
    directory "/var/cache/bind";
    recursion yes;
    allow-query { any; };

    forwarders { ${upstream}; };
    forward only;
    dnssec-validation auto;

    listen-on-v6 { any; };
    listen-on { none; };

    dns64 ${prefix} {
        clients { any; };
        break-dnssec yes;
%{ if force_synth ~}
        // Preserve internal IPv6 records and synthesize external destinations.
        exclude {
%{ for native_prefix in native_ipv6_prefixes ~}
            !${native_prefix};
%{ endfor ~}
            any;
        };
%{ endif ~}
    };
};
