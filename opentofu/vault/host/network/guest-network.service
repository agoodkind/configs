[Unit]
Description=Guest forwarding and IPv4 masquerade
After=networking.service
Before=pve-guests.service tayga.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/sysctl --load=/etc/sysctl.d/70-vault-guest-network.conf
ExecStart=/usr/sbin/nft --file /etc/vault-guest-network.nft
ExecReload=/usr/sbin/nft --file /etc/vault-guest-network.nft

[Install]
WantedBy=multi-user.target
