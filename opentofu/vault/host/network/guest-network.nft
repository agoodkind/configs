destroy table ip vault_guests
table ip vault_guests {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "mbrains" ip saddr 10.250.0.0/24 masquerade
    }
}

destroy table inet vault_guests
table inet vault_guests {
    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname "mbrains" oifname "vmbr0" ct state established,related accept
        iifname "mbrains" oifname "vmbr0" drop
    }
}
