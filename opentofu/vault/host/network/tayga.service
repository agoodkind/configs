[Unit]
Description=Guest IPv6 to IPv4 translation
After=networking.service
Before=pve-guests.service

[Service]
Type=simple
StateDirectory=tayga
ExecStartPre=/usr/sbin/tayga --config /etc/tayga.conf --mktun
ExecStartPre=/usr/sbin/ip address replace 10.250.64.1/24 dev nat64
ExecStartPre=/usr/sbin/ip -6 address replace 3d06:bad:b01:64::1/128 dev nat64
ExecStartPre=/usr/sbin/ip link set dev nat64 up
ExecStartPre=/usr/sbin/ip -6 route replace 3d06:bad:b01:6464::/96 dev nat64
ExecStart=/usr/sbin/tayga --config /etc/tayga.conf --nodetach
ExecStopPost=/usr/sbin/tayga --config /etc/tayga.conf --rmtun
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
