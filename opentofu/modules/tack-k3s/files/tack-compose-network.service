[Unit]
Description=Apply the Tack Compose IPv6 network configuration
Requires=docker.service tack-k3s-kafka-firewall.service
After=docker.service tack-k3s-kafka-firewall.service
AssertPathExists=/root/tack/docker-compose.yml
AssertPathExists=/root/tack/docker-compose.override.yml
AssertPathExists=/root/tack/docker-compose.k3s-kafka.yml
AssertPathExists=/root/tack/.env
AssertPathExists=/etc/systemd/system/tack-k3s-kafka-listener.service

[Service]
Type=oneshot
WorkingDirectory=/root/tack
ExecStart=/usr/bin/systemctl daemon-reload
ExecStart=/usr/bin/systemctl stop tack-k3s-kafka-listener.service
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.k3s-kafka.yml down
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.k3s-kafka.yml up -d --no-deps --no-build app audit-consumer
ExecStart=/usr/bin/systemctl start tack-k3s-kafka-listener.service
RemainAfterExit=yes
TimeoutStartSec=280
