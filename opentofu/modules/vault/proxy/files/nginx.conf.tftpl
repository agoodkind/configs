load_module /usr/lib/nginx/modules/ngx_stream_module.so;
load_module /usr/lib/nginx/modules/ngx_http_headers_more_filter_module.so;
user www-data;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 4096;
}

http {
    server_tokens off;
    more_clear_headers Server;
    client_max_body_size 0;
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
    ssl_certificate /var/lib/lego/certificates/${primary_certificate}.crt;
    ssl_certificate_key /var/lib/lego/certificates/${primary_certificate}.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
%{ for subnet in ["127.0.0.1/32", "10.0.0.0/8", "::1/128", "3d06:bad:b01::/56", "173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22", "141.101.64.0/18", "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20", "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13", "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22", "2400:cb00::/32", "2606:4700::/32", "2803:f800::/32", "2405:b500::/32", "2405:8100::/32", "2a06:98c0::/29", "2c0f:f248::/32"] ~}
    set_real_ip_from ${subnet};
%{ endfor ~}

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    geo $realip_remote_addr $internal_peer {
        default 0;
        127.0.0.1/32 1;
        10.0.0.0/8 1;
        ::1/128 1;
        3d06:bad:b01::/56 1;
    }

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        return 308 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2 default_server;
        listen [::]:443 ssl http2 default_server;
        return 404;
    }

%{ for hostname, route in routes ~}
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name ${hostname};
        add_header X-Content-Type-Options nosniff always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Robots-Tag "none,noarchive,nosnippet,notranslate,noimageindex" always;
%{ if try(route.hsts, true) ~}
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
%{ endif ~}
%{ if try(route.internal_only, false) ~}
        if ($internal_peer = 0) { return 403; }
%{ endif ~}

        location / {
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 1h;
            proxy_buffering off;
            proxy_request_buffering off;
%{ if can(route.upstream_sni) ~}
            proxy_ssl_server_name on;
            proxy_ssl_name ${route.upstream_sni};
%{ endif ~}
            proxy_pass ${route.origin};
        }
    }

%{ endfor ~}
}

stream {
%{ for route in streams ~}
    server {
        listen ${route.port}${route.protocol == "udp" ? " udp reuseport" : ""};
        listen [::]:${route.port}${route.protocol == "udp" ? " udp reuseport" : ""};
        proxy_pass ${route.origin};
    }
%{ endfor ~}
}
