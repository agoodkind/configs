[Unit]
Description=Issue the proxy TLS certificate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
StateDirectory=lego
StateDirectoryMode=0700
UMask=0077
Environment=CLOUDFLARE_DNS_API_TOKEN_FILE=/etc/lego/cloudflare-dns-token
ExecCondition=/usr/bin/test /etc/systemd/system/proxy-certificate.service -nt /var/lib/lego/certificates/${primary}.crt
ExecStart=${lego_command} run
