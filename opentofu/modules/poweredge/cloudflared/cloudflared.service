[Unit]
Description=Cloudflare private network tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=30
DynamicUser=yes
AmbientCapabilities=CAP_NET_RAW
LoadCredential=tunnel-token:/etc/cloudflared/token
ExecStart=/usr/bin/cloudflared --no-autoupdate --edge-ip-version 6 tunnel --metrics 127.0.0.1:20241 run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
