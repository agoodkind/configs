	post-up ip link set nic3 vf 0 mac 02:57:50:04:03:00
	post-up if [ -e /sys/class/net/nic3/device/virtfn0/net/*/ifindex ]; then basename "$(readlink /sys/class/net/nic3/device/virtfn0)" > /sys/class/net/nic3/device/virtfn0/driver/unbind; basename "$(readlink /sys/class/net/nic3/device/virtfn0)" > /sys/bus/pci/drivers_probe; fi
	post-up udevadm settle
