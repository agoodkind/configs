[Unit]
Description=Retire the Tack search proxy and caller configuration
Conflicts=tack-search-proxy.service tack-search-caller.service
After=tack-search-proxy.service tack-search-caller.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemd-tmpfiles --remove /usr/local/share/tack/retire-search-proxy.conf
ExecStartPost=/usr/bin/systemctl daemon-reload
