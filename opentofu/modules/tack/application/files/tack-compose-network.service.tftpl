[Unit]
Description=Apply the Tack Compose IPv6 network configuration
Requires=docker.service tack-k3s-kafka-firewall.service
After=docker.service tack-k3s-kafka-firewall.service
AssertPathExists=/root/tack/docker-compose.yml
AssertPathExists=/root/tack/docker-compose.override.yml
AssertPathExists=/root/tack/docker-compose.k3s-kafka.yml
AssertPathExists=/root/tack/.env
AssertPathExists=/etc/systemd/system/tack-k3s-kafka-listener.service

[Service]
Type=oneshot
WorkingDirectory=/root/tack
ExecStart=/usr/bin/timeout --signal=TERM --kill-after=10s 240 /usr/local/sbin/tack-compose-network ${dynamic_range}
RemainAfterExit=yes
TimeoutStartSec=280
