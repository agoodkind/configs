{
    "Dhcp6": {
        "interfaces-config": {
            "interfaces": ["eth0"],
            "service-sockets-max-retries": ${socket_max_retries},
            "service-sockets-retry-wait-time": ${socket_retry_wait_milliseconds}
        },
        "lease-database": { "type": "memfile", "persist": false },
        "preferred-lifetime": ${preferred_lifetime_seconds},
        "valid-lifetime": ${valid_lifetime_seconds},
%{ if renew_seconds != null ~}
        "renew-timer": ${renew_seconds},
%{ endif ~}
%{ if rebind_seconds != null ~}
        "rebind-timer": ${rebind_seconds},
%{ endif ~}
%{ if length(dns_servers) > 0 ~}
        "option-data": [{
            "name": "dns-servers",
            "data": ${jsonencode(join(", ", dns_servers))}
        }],
%{ endif ~}
        "subnet6": [{
            "id": 1,
%{ if address_pool != null ~}
            "subnet": "${slaac_prefix}",
            "interface": "eth0",
            "pools": [{ "pool": "${address_pool}" }],
%{ else ~}
            "subnet": "fe80::/10",
            "interface": "eth0",
%{ endif ~}
            "pd-pools": [{ "prefix": "${pd_network}", "prefix-len": ${pd_length}, "delegated-len": ${pd_length} }]
        }]
    }
}
