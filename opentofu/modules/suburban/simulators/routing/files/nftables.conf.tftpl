#!/usr/sbin/nft -f
flush ruleset

%{ if length(uplink_sources) > 0 ~}
table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
%{ for source in uplink_sources ~}
        oifname "${management_interface}" ip saddr ${source} masquerade
%{ endfor ~}
    }
}

%{ endif ~}
table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        iifname "${management_interface}" accept
        ct state established,related accept
        ip protocol icmp accept
        meta l4proto ipv6-icmp accept
%{ for tunnel in tunnels ~}
        ip saddr ${tunnel.peer_outer_ipv4} ip daddr ${tunnel.outer_ipv4} ip protocol 41 accept
%{ endfor ~}
%{ for address in bgp_peers ~}
        ip6 saddr ${address} tcp dport 179 accept
%{ endfor ~}
%{ if transfer_server ~}
        tcp dport ${transfer_port} accept
%{ endif ~}
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
%{ if length(uplink_sources) > 0 ~}
        iifname { ${uplink_interfaces} } oifname "${management_interface}" ip saddr { ${join(", ", uplink_sources)} } accept
        iifname "${management_interface}" oifname { ${uplink_interfaces} } ct state established,related accept
%{ endif ~}
        iifname "${management_interface}" drop
        oifname "${management_interface}" drop
%{ if forwarding ~}
        iifname { ${forward_interfaces} } oifname { ${forward_interfaces} } accept
%{ endif ~}
    }
}
