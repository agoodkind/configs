services:
  opensearch:
    image: opensearchproject/opensearch:3.8.0@sha256:fafe3fc3587088674669235575aa166228c48bdb940294a8cdbbc1da75236a40
    restart: unless-stopped
    mem_limit: 8g
    environment:
      DISABLE_INSTALL_DEMO_CONFIG: "true"
      OPENSEARCH_JAVA_OPTS: -Xms3g -Xmx3g -XX:G1PeriodicGCInterval=5000
    network_mode: host
    volumes:
      - search:/usr/share/opensearch/data
      - /opt/tack-qa/search/opensearch.yml:/usr/share/opensearch/config/opensearch.yml:ro
      - /opt/tack-qa/search:/usr/share/opensearch/config/tack:ro
volumes:
  search:
networks:
  default:
    enable_ipv6: true
    enable_ipv4: false
    driver_opts:
      com.docker.network.bridge.gateway_mode_ipv6: routed
    ipam:
      config:
        - subnet: ${guest.subnet}
          gateway: ${guest.gateway}
