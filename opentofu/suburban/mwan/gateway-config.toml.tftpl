# MWAN runtime config
# Rendered by OpenTofu, deployed to /etc/mwan/config.toml

hostname = "${c.hostname}"
mwan_vmid = "${c.vmid}"
mwan_mgmt_addr = "${c.management_address}"

[email]
smtp2go_api_key = "${c.smtp2go_api_key}"
alert_email = "${c.email_recipient}"
from = "${c.email_from}"
subject_prefix = "${c.email_subject_prefix}"
bind_iface = "${c.email_bind_iface}"
min_level = "${c.email_min_level}"
cooldown = "${c.email_cooldown}"

[pve]
base_url = "${c.pve_base_url}"
node = "${c.pve_node}"
token_id = "${c.pve_token_id}"
token_secret = "${c.pve_token_secret}"

[network]
ping_target_ipv4 = "1.1.1.1"
ping_target_ipv6 = "2606:4700:4700::1111"
ping_targets = ["2606:4700:4700::1111", "2001:4860:4860::8888"]
curl_target = "https://ifconfig.co/ip"
last_deploy_path = "/var/lib/mwan/last-deploy"
last_change_path = "/var/run/mwan-last-change"

[watchdog]
service_name = "${c.watchdog_service_name}"
deploy_window_minutes = 30
connectivity_timeout_seconds = 60
check_interval_healthy_seconds = 30
check_interval_degraded_seconds = 10
post_rollback_grace_seconds = 120
alert_cooldown_seconds = 300
deploy_grace_period_seconds = 60
max_rollback_attempts = 3
snapshot_healthy_threshold = 20
max_known_good_snapshots = 2
hash_check_every_n_healthy = 10
min_snapshot_interval_seconds = 300
max_total_snapshots = 15
vsock_cid = ${c.vmid}
vsock_port = 50051
mwan_agent_tcp_addr = "${c.watchdog_agent_tcp_addr}"
log_file = "${c.watchdog_log_file}"
json_log_file = "${c.watchdog_json_log_file}"
rollback_state_file = "${c.watchdog_state_file}"
rollback_lock_file = "${c.watchdog_lock_file}"

[failover]
lxc_id = "${c.failover_vmid}"

[opnsense]
url = "${c.opnsense_url}"
api_key = "${c.opnsense_api_key}"
api_secret = "${c.opnsense_api_secret}"
insecure = true
nptv6_hairpin_alias = "${c.nptv6_hairpin_alias}"
nptv6_hairpin_ca_file = "${c.nptv6_hairpin_ca_file}"
gateway_names = ${jsonencode(c.opnsense_gateway_names)}

[opnsense.bgp]
router_id = "${c.opnsense_bgp_router_id}"
firewall_source_v4 = "${c.opnsense_bgp_firewall_source_v4}"
firewall_source_v6 = "${c.opnsense_bgp_firewall_source_v6}"

%{ for neighbor in c.opnsense_bgp_neighbors ~}
[[opnsense.bgp.neighbors]]
address = "${neighbor.address}"
description = "${neighbor.description}"
preference = "${neighbor.preference}"

%{ endfor ~}
[agent]
vsock_port = 50051
tcp_addr = "[::]:50052"
deploy_file = "/var/lib/mwan/last-deploy"
deploy_expected = true
log_file = "/var/log/mwan-agent.log"
debug = false

[bgp]
enabled = true
use_wanconfig = true
asn = ${c.bgp_asn}
router_id = "${c.bgp_router_id}"
next_hop_v6 = "${c.bgp_next_hop_v6}"
keepalive_seconds = ${c.bgp_keepalive_seconds}
hold_seconds = ${c.bgp_hold_seconds}
listen_port = ${c.bgp_listen_port}
learned_route_iface = "${c.bgp_learned_route_iface}"
dynamic_neighbors = ${jsonencode(c.bgp_dynamic_neighbors)}

%{ for neighbor in c.bgp_neighbors ~}
[[bgp.neighbors]]
address = "${neighbor}"

%{ endfor ~}
%{ for neighbor in c.bgp_neighbors_v6 ~}
[[bgp.neighbors_v6]]
address = "${neighbor}"

%{ endfor ~}
[bgp.announce]
ipv4 = ${jsonencode(c.bgp_announce_ipv4)}
ipv6 = ${jsonencode(c.bgp_announce_ipv6)}

[bgp.graceful_restart]
enabled = ${c.bgp_graceful_restart_enabled}
restart_time = ${c.bgp_graceful_restart_time_seconds}
notification_enabled = ${c.bgp_graceful_restart_notification_enabled}

[bgp.forwarding_readiness]
socket_path = "${c.bgp_forwarding_readiness_socket_path}"
poll_interval_milliseconds = ${c.bgp_forwarding_readiness_poll_interval_milliseconds}
read_timeout_milliseconds = ${c.bgp_forwarding_readiness_read_timeout_milliseconds}

# This gateway has the wanconfig stack. ifmgr publishes its loaded
# configuration into the wanconfig management datastore (sysrepo) at startup.
[wanconfig]
publish = true

[ifmgr]
reconcile_interval = "60s"
lease_directory = "/var/lib/mwan"
log_file = "/var/log/mwan-ifmgr.log"
json_log_file = "/var/log/mwan-ifmgr.jsonl"

[ifmgr.iface.${c.ifmgr_iface_key}]
name = "${c.ifmgr_iface_name}"
dhcp_v4 = true
ra_solicit = true
dhcp_initial_backoff = "5s"
dhcp_max_backoff = "5m"

[ifmgr.modules.links]
state_file = "${c.links_state_file}"

[ifmgr.modules.autoconfiguration]
state_file = "${c.autoconfiguration_state_file}"

[ifmgr.modules.addresses]
state_file = "/var/lib/mwan/owned-addresses.json"

[ifmgr.modules.bgp_sessions]
state_file = "${c.bgp_sessions_state_file}"

[ifmgr.modules.resolver]
state_file = "${c.resolver_state_file}"

[ifmgr.modules.wan.routes]
health_state_file = "${c.health_state_file}"

[ifmgr.modules.health]
state_file = "${c.health_state_file}"
# Context id 2 is VMADDR_CID_HOST, the kernel's fixed id for a guest's own
# hypervisor. No site can change it.
status_push_cid = 2
status_push_port = ${c.status_push_port}
