{
  "node": "hypervisor",
  "environment": "testbed",
  "validation_file": "mwan/config/artifact-validation.json",
  "directories": [
    {
      "path": "/etc/mwan",
      "mode": "0755",
      "owner": "root",
      "group": "root"
    },
    {
      "path": "/etc/opnsensectl",
      "mode": "0755",
      "owner": "root",
      "group": "root"
    },
    {
      "path": "/etc/systemd/system/mwan-ifmgr.service.d",
      "mode": "0755",
      "owner": "root",
      "group": "root"
    },
    {
      "path": "/var/lib/mwan",
      "mode": "0750",
      "owner": "root",
      "group": "root"
    }
  ],
  "files": [
    {
      "destination": "/etc/mwan/config.toml",
      "source": "template:mwan/config/config-host.toml.j2",
      "mode": "0600",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/opnsensectl/config.toml",
      "source": "template:opnsense/config.toml.j2",
      "mode": "0600",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/systemd/system/mwan-ifmgr.service",
      "source": "asset:agoodkind/mwan:gateway/internal/installspec/mwan-ifmgr.service",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/systemd/system/mwan-ifmgr.service.d/oob-dhcpv4.conf",
      "source": "asset:agoodkind/configs:proxmox/services/mwan-ifmgr-oob-dhcpv4.conf",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/systemd/system/mwan-opnsense-host.service",
      "source": "asset:agoodkind/opnsensectl:cmd/opnsensectl/mwan-opnsense-host.service",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/systemd/system/mwan-opnsense-drain.service",
      "source": "asset:agoodkind/opnsensectl:cmd/opnsensectl/mwan-opnsense-drain.service",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/systemd/system/mwan-watchdog-testbed.service",
      "source": "template:proxmox/services/mwan-watchdog.service.j2",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/systemd/system/mwan-ifmgr.service.d/suburban-host-ipv6-policy.conf",
      "source": "asset:agoodkind/configs:proxmox/services/mwan-ifmgr-suburban-host-ipv6-policy.conf",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    }
  ],
  "secret_fields": [
    {
      "name": "SMTP2GO_API_KEY",
      "storage_path": "/etc/mwan/secrets.env",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "pattern": "^[A-Za-z0-9-]+$",
      "min_length": 16,
      "max_length": 128,
      "consumer_units": [
        "mwan-ifmgr.service",
        "mwan-watchdog-testbed.service"
      ]
    }
  ],
  "configuration_dependencies": [
    "opentofu/modules/suburban/config.tf",
    "opentofu/modules/suburban/endpoint.tf",
    "opentofu/modules/suburban/mwan/configuration/artifact.tf",
    "opentofu/modules/suburban/mwan/configuration/failover_vars.tf",
    "opentofu/modules/suburban/mwan/configuration/main.tf",
    "opentofu/modules/suburban/mwan/configuration/routing_prefixes.tf",
    "opentofu/modules/suburban/mwan/configuration/suburban_vars.tf",
    "opentofu/modules/suburban/mwan/configuration/testbed_release.tf",
    "opentofu/modules/suburban/services/isp_routed_suburban/main.tf",
    "opentofu/modules/suburban/services/isp_sonic_suburban/main.tf",
    "opentofu/modules/suburban/services/isp_webpass_suburban/main.tf",
    "opentofu/modules/suburban/services/opnsense_suburban/main.tf",
    "opentofu/modules/suburban/services/routing_astound_static_endpoint_suburban/main.tf",
    "opentofu/modules/suburban/services/routing_etheric_native_router_suburban/main.tf",
    "opentofu/modules/suburban/services/routing_tunnel_static_vps_suburban/main.tf",
    "opentofu/modules/suburban/services/routing_tunnel_upstream_upstream_suburban/main.tf",
    "opentofu/modules/suburban/services/routing_tunnel_upstream_vps_suburban/main.tf",
    "opentofu/modules/suburban/services/routing_tunnel_vps_vps_suburban/main.tf",
    "opentofu/modules/suburban/services/suburban_hypervisor/main.tf",
    "opentofu/modules/vault/services/proxy/main.tf",
    "opentofu/modules/vault/services/proxy/ssh.tf"
  ]
}
