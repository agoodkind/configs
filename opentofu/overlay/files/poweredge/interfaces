auto lo
iface lo inet loopback

auto ens1f0
iface ens1f0 inet static
	address 10.230.0.254/24
	gateway 10.230.0.1
	address 3d06:bad:b01:300::254/64
	accept-ra 2
	autoconf 1

iface ens1f1 inet manual

auto nic0
iface nic0 inet manual
	post-up if [ "$(cat /sys/class/net/nic0/device/sriov_numvfs)" -eq 0 ]; then echo 2 > /sys/class/net/nic0/device/sriov_numvfs; else test "$(cat /sys/class/net/nic0/device/sriov_numvfs)" -eq 2; fi
	post-up ip link set nic0 vf 0 mac 02:57:50:04:00:03
	post-up ip link set nic0 vf 1 mac 02:57:50:04:00:00
	post-up if [ -e /sys/class/net/nic0/device/virtfn0/net/*/ifindex ]; then basename "$(readlink /sys/class/net/nic0/device/virtfn0)" > /sys/class/net/nic0/device/virtfn0/driver/unbind; basename "$(readlink /sys/class/net/nic0/device/virtfn0)" > /sys/bus/pci/drivers_probe; fi
	post-up if [ -e /sys/class/net/nic0/device/virtfn1/net/*/ifindex ]; then basename "$(readlink /sys/class/net/nic0/device/virtfn1)" > /sys/class/net/nic0/device/virtfn1/driver/unbind; basename "$(readlink /sys/class/net/nic0/device/virtfn1)" > /sys/bus/pci/drivers_probe; fi

# Preserve active VFs during reloads and reject a conflicting VF count.
# The driver reads each permanent MAC when it binds in the host namespace.
auto nic1
iface nic1 inet manual
	post-up if [ "$(cat /sys/class/net/nic1/device/sriov_numvfs)" -eq 0 ]; then echo 3 > /sys/class/net/nic1/device/sriov_numvfs; else test "$(cat /sys/class/net/nic1/device/sriov_numvfs)" -eq 3; fi
	post-up ip link set nic1 vf 0 mac 02:57:50:04:01:00
	post-up ip link set nic1 vf 1 mac 02:57:50:04:01:01
	post-up ip link set nic1 vf 2 mac 02:57:50:04:01:02
	post-up if [ -e /sys/class/net/nic1/device/virtfn0/net/*/ifindex ]; then basename "$(readlink /sys/class/net/nic1/device/virtfn0)" > /sys/class/net/nic1/device/virtfn0/driver/unbind; basename "$(readlink /sys/class/net/nic1/device/virtfn0)" > /sys/bus/pci/drivers_probe; fi
	post-up if [ -e /sys/class/net/nic1/device/virtfn1/net/*/ifindex ]; then basename "$(readlink /sys/class/net/nic1/device/virtfn1)" > /sys/class/net/nic1/device/virtfn1/driver/unbind; basename "$(readlink /sys/class/net/nic1/device/virtfn1)" > /sys/bus/pci/drivers_probe; fi
	post-up if [ -e /sys/class/net/nic1/device/virtfn2/net/*/ifindex ]; then basename "$(readlink /sys/class/net/nic1/device/virtfn2)" > /sys/class/net/nic1/device/virtfn2/driver/unbind; basename "$(readlink /sys/class/net/nic1/device/virtfn2)" > /sys/bus/pci/drivers_probe; fi
	post-up ip link set nic1 vf 1 state enable
	post-up ip link set nic1 vf 2 state enable

auto nic2
iface nic2 inet manual
	post-up if [ "$(cat /sys/class/net/nic2/device/sriov_numvfs)" -eq 0 ]; then echo 1 > /sys/class/net/nic2/device/sriov_numvfs; else test "$(cat /sys/class/net/nic2/device/sriov_numvfs)" -eq 1; fi
	post-up ip link set nic2 vf 0 mac 02:57:50:04:02:00
	post-up if [ -e /sys/class/net/nic2/device/virtfn0/net/*/ifindex ]; then basename "$(readlink /sys/class/net/nic2/device/virtfn0)" > /sys/class/net/nic2/device/virtfn0/driver/unbind; basename "$(readlink /sys/class/net/nic2/device/virtfn0)" > /sys/bus/pci/drivers_probe; fi

auto nic3
iface nic3 inet manual
	post-up if [ "$(cat /sys/class/net/nic3/device/sriov_numvfs)" -eq 0 ]; then echo 1 > /sys/class/net/nic3/device/sriov_numvfs; else test "$(cat /sys/class/net/nic3/device/sriov_numvfs)" -eq 1; fi
	post-up ip link set nic3 vf 0 mac 02:57:50:04:03:00
	post-up if [ -e /sys/class/net/nic3/device/virtfn0/net/*/ifindex ]; then basename "$(readlink /sys/class/net/nic3/device/virtfn0)" > /sys/class/net/nic3/device/virtfn0/driver/unbind; basename "$(readlink /sys/class/net/nic3/device/virtfn0)" > /sys/bus/pci/drivers_probe; fi

source /etc/network/interfaces.d/*
