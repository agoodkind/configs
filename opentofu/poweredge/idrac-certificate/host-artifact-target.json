{
  "node": "poweredge",
  "environment": "testbed",
  "validation_file": "opentofu/modules/poweredge/idrac-certificate/artifact-validation.json",
  "directories": [
    {
      "path": "/opt/configs/idrac-certificate",
      "mode": "0755",
      "owner": "root",
      "group": "root"
    },
    {
      "path": "/opt/configs/idrac-certificate/bin",
      "mode": "0755",
      "owner": "root",
      "group": "root"
    },
    {
      "path": "/opt/configs/idrac-certificate/workspace",
      "mode": "0755",
      "owner": "root",
      "group": "root"
    }
  ],
  "files": [
    {
      "destination": "/opt/configs/idrac-certificate/configsctl.yml",
      "source": "template:opentofu/modules/poweredge/idrac-certificate/configsctl.yml.j2",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/binaries.sha256",
      "source": "template:opentofu/modules/poweredge/idrac-certificate/binaries.sha256.j2",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/hosts",
      "source": "asset:agoodkind/configs:opentofu/modules/poweredge/idrac-certificate/hosts",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/workspace/idrac-ca.pem",
      "source": "asset:agoodkind/configs:opentofu/poweredge/firmware/idrac-ca.pem",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/workspace/.terraform.lock.hcl",
      "source": "asset:agoodkind/configs:opentofu/poweredge/idrac-certificate/.terraform.lock.hcl",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/workspace/backend.tf",
      "source": "asset:agoodkind/configs:opentofu/poweredge/idrac-certificate/backend.tf",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/workspace/encryption.tf",
      "source": "asset:agoodkind/configs:opentofu/poweredge/idrac-certificate/encryption.tf",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/workspace/main.tf",
      "source": "asset:agoodkind/configs:opentofu/poweredge/idrac-certificate/main.tf",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/workspace/providers.tf",
      "source": "asset:agoodkind/configs:opentofu/poweredge/idrac-certificate/providers.tf",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/opt/configs/idrac-certificate/workspace/variables.tf",
      "source": "asset:agoodkind/configs:opentofu/poweredge/idrac-certificate/variables.tf",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/systemd/system/idrac-certificate.service",
      "source": "asset:agoodkind/configs:opentofu/modules/poweredge/idrac-certificate/idrac-certificate.service",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/systemd/system/idrac-certificate.timer",
      "source": "asset:agoodkind/configs:opentofu/modules/poweredge/idrac-certificate/idrac-certificate.timer",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    },
    {
      "destination": "/etc/network/interfaces.d/idrac",
      "source": "asset:agoodkind/configs:opentofu/modules/poweredge/idrac-certificate/usb-interface",
      "mode": "0644",
      "owner": "root",
      "group": "root"
    }
  ],
  "configuration_dependencies": [
    "opentofu/modules/poweredge/idrac-certificate/configuration/main.tf"
  ]
