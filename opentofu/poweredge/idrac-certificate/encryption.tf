terraform {
  encryption {
    key_provider "pbkdf2" "state" {
      passphrase = var.vault_idrac_certificate_state_passphrase
    }
    method "aes_gcm" "state" {
      keys = key_provider.pbkdf2.state
    }
    state {
      method   = method.aes_gcm.state
      enforced = true
    }
    plan {
      method   = method.aes_gcm.state
      enforced = true
    }
  }
}
