interface eth0
{
    AdvSendAdvert on;
    MinRtrAdvInterval ${ra_min_interval_seconds};
    MaxRtrAdvInterval ${ra_max_interval_seconds};
    AdvManagedFlag on;
    AdvOtherConfigFlag on;
%{~ if length(ra_dns_servers) > 0 }
    RDNSS ${join(" ", ra_dns_servers)}
    {
        AdvRDNSSLifetime ${ra_dns_lifetime_seconds};
    };
%{~ endif }
%{~ if slaac_prefix != "" }
    # SLAAC /64 (AdvAutonomous on) so the WAN VM autoconfigures a global address,
    # mirroring prod where the ISP RA yields a SLAAC mngtmpaddr. The PD prefix is
    # delegated by kea-dhcp6, not advertised for autoconf here.
    prefix ${slaac_prefix}
    {
        AdvOnLink on;
        AdvAutonomous on;
        AdvRouterAddr off;
%{~ if ra_prefix_valid_lifetime_seconds != "omit" }
        AdvValidLifetime ${ra_prefix_valid_lifetime_seconds};
%{~ endif }
%{~ if ra_prefix_preferred_lifetime_seconds != "omit" }
        AdvPreferredLifetime ${ra_prefix_preferred_lifetime_seconds};
%{~ endif }
    };
%{~ endif }
};
