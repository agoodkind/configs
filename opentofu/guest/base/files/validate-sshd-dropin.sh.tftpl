set -eu

new_dropin=%s
candidate=$(mktemp)
trap 'rm -f "$candidate"' EXIT

placed=0
for dropin in ${dropin_dir}/*.conf; do
    if [ "$dropin" = '${destination}' ]; then
        cat "$new_dropin" >> "$candidate"
        placed=1
    elif [ -f "$dropin" ]; then
        cat "$dropin" >> "$candidate"
    fi
done
if [ "$placed" -eq 0 ]; then
    cat "$new_dropin" >> "$candidate"
fi

sed '/^[[:space:]]*include[[:space:]]/Id' /etc/ssh/sshd_config >> "$candidate"

# `sshd -t` fails without the privilege separation directory, and the entry in
# /etc/tmpfiles.d/sshd.conf creates it only at boot.
mkdir -p -m 0755 /run/sshd
sshd -t -f "$candidate"
